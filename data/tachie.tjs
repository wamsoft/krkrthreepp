/**
 * Tachie — VRM を ADV 立ち絵として扱う 1 キャラ分の枠組み
 *
 * 1 キャラ = 1 dest レイヤ。自前の Scene / VRM / カメラ / フレーミングを持ち、
 * 共有の GLESAdaptor + GLRenderer で自分の dest レイヤへ描画する。
 * 画面内の左右位置は dest レイヤの setPos で決める(吉里吉里 2D 側の配置)。
 *
 * "生きてる立ち絵" の最低ライン:
 *   - 自動まばたき (blink 表情のパルス)
 *   - カメラ目線 (setLookAtTarget をカメラ位置に向ける)
 *   - 表情の切り替え (setEmotion)
 *
 * 前提: Threepp / GLESAdaptor プラグインは link 済み、VRMFraming は execStorage 済み。
 */
class Tachie
{
    var owner;      // Window
    var adaptor;    // 共有 GLESAdaptor
    var renderer;   // 共有 Threepp.GLRenderer
    var framer;     // 共有 VRMFraming

    var scene;      // このキャラ専用 Scene
    var vrm;        // Threepp.VRM
    var camera;     // Threepp.PerspectiveCamera (このキャラ用フレーミング)
    var dest;       // 描画結果を受ける Layer

    var w, h;       // 描画バッファ(=dest レイヤ)のサイズ
    var preset  = "bust";
    var frontZ  = 1;   // +1=VRM1.0 正面(+Z) / -1=VRM0.x

    // --- 自動まばたき ---
    var blinkEnabled  = true;
    var blinkClock    = 0.0;   // 次のまばたきまでの経過
    var blinkInterval = 3.0;   // 次のまばたきまでの間隔(秒)
    var blinkPhase    = -1;    // -1:待機 0:閉じ 1:開き
    var blinkTime     = 0.0;
    var blinkSeed     = 0;     // 間隔ゆらぎ用

    // --- 表情(感情) --- weight を時間補間してなめらかに切替
    var emotion = "";          // 目標の感情表情("" = 素/neutral)
    var emoW = 0.0;            // emotion の現在ウェイト(0→1)
    var prevEmotion = "";      // フェードアウト中の前の表情
    var prevW = 0.0;           // その現在ウェイト(→0)
    var emoDur = 0.15;         // 遷移時間(秒)

    // --- カメラ目線(視線ADV化) ---
    // 多くの VRM は素の目が正面向き(=前面カメラのプレイヤーを見ている)。VRM の
    // bone lookAt を通すとむしろ下向き等のズレが出るため、前面 ADV では既定 OFF。
    // カメラを旋回して追従させたい時だけ ON にする(トグル)。
    var lookAtCamera = false;

    // --- idle 呼吸 ---
    var idleEnabled = true;
    var idleT = 0.0;

    // --- 空間モードでの配置(world) ---
    var offX = 0.0, offZ = 0.0;   // 左右(x) / 前後(z)

    // --- VRMA モーション再生 ---
    var motionAnim;               // Threepp.VRMAnimation("" のとき無し)
    var motionDur = 0.0, motionTime = 0.0;
    var motionLoop = true, motionPlaying = false;

    // --- カメラ姿勢(フレーミング基準 + 旋回/ズーム) ---
    var camTX = 0.0, camTY = 1.0, camTZ = 0.0;  // 注視点(world)
    var camBaseDist = 2.0;      // フレーミングが決めた基準距離
    var camYaw = 0.0;           // 水平旋回(0=正面)
    var camPitch = 0.0;         // 仰俯
    var camDistScale = 1.0;     // ズーム倍率
    // 視線の原点近似 = head ボーン world 位置。ここから遠方を見て視線を安定させる。
    var headWX = 0.0, headWY = 1.4, headWZ = 0.0;

    function Tachie(owner, adaptor, renderer, framer, parentLayer, w, h)
    {
        this.owner    = owner;
        this.adaptor  = adaptor;
        this.renderer = renderer;
        this.framer   = framer;
        this.w = w;
        this.h = h;

        scene  = new Threepp.Scene();
        camera = new Threepp.PerspectiveCamera(30, w * 1.0 / h, 0.1, 100);

        // 立ち絵向けの素直なライト(背景に馴染ませる調整は将来)
        var dir = new Threepp.DirectionalLight(0xffffff, 1.35);
        dir.setPosition(0.5, 1.0, 1.0);
        scene.add(dir);
        var amb = new Threepp.AmbientLight(0xffffff, 0.75);
        scene.add(amb);

        // 描画結果を受けるレイヤ (α込みを通常アルファ合成)
        dest = new Layer(owner, parentLayer);
        dest.setImageSize(w, h);
        dest.setSize(w, h);
        dest.type = ltAlpha;
        dest.visible = true;
        owner.add(dest);
    }

    // VRM を読み込み、指定位置へ配置してフレーミングする
    function load(vrmName, frontZ, x, y)
    {
        this.frontZ = frontZ;
        var loader = new Threepp.VRMLoader();
        vrm = loader.loadStorage(Storages.getPlacedPath(vrmName + ".vrm"));
        if (vrm === void) {
            Debug.message("Tachie: VRM load failed: " + vrmName);
            return false;
        }
        scene.add(vrm.getScene());
        restPose();
        dest.setPos(x, y);
        // 間隔ゆらぎの初期位相をキャラごとにずらす
        blinkSeed = (x + 1) * 131 + 7;
        blinkInterval = 2.4 + (blinkSeed % 20) / 10.0;
        frame(preset);
        return true;
    }

    // 素立ちポーズ: T字ポーズの腕を体側へ下ろす。
    // normalized ボーンに与えると vrm.update() が raw へ写して持続する
    // (VRMA を applyAnimation しない限りこの姿勢のまま)。
    function restPose()
    {
        var lua = vrm.getNormalizedBoneNode("leftUpperArm");
        var rua = vrm.getNormalizedBoneNode("rightUpperArm");
        // 前方(+Z)向き・上(+Y)・腕は±X。Z軸回りに回して腕を下ろす。
        if (lua !== void) lua.rotateZ(-1.25);
        if (rua !== void) rua.rotateZ( 1.25);
        // 軽く肘を曲げて自然に
        var lla = vrm.getNormalizedBoneNode("leftLowerArm");
        var rla = vrm.getNormalizedBoneNode("rightLowerArm");
        if (lla !== void) lla.rotateY(-0.20);
        if (rla !== void) rla.rotateY( 0.20);
    }

    // フレーミングプリセットを適用する。注視点と基準距離を控え、旋回/ズームは維持。
    function frame(p)
    {
        preset = p;
        framer.frontZ = frontZ;
        var r = framer.apply(vrm, camera, scene, p, w * 1.0 / h);
        camTX = r.tx; camTY = r.ty; camTZ = r.tz;
        camBaseDist = r.dist;
        // 視線の原点 = head ボーン world 位置(lookAt の原点 head+offset に近い)
        var hd = vrm.getBoneNode("head");
        if (hd !== void) {
            var hp = hd.getWorldPosition();
            headWX = hp.x; headWY = hp.y; headWZ = hp.z;
        }
        updateCameraPose();
    }

    // 注視点まわりの旋回/ズームからカメラ位置を決めて置く
    function updateCameraPose()
    {
        var dist = camBaseDist * camDistScale;
        var cp = Math.cos(camPitch);
        var px = camTX + dist * Math.sin(camYaw) * cp;
        var py = camTY + dist * Math.sin(camPitch);
        var pz = camTZ + frontZ * dist * Math.cos(camYaw) * cp;
        camera.setPosition(px, py, pz);
        camera.lookAt(camTX, camTY, camTZ);
        camera.updateProjectionMatrix();
        if (lookAtCamera) applyLookAtCamera();
    }

    // カメラ操作
    function orbit(dyaw, dpitch)
    {
        camYaw += dyaw; camPitch += dpitch;
        if (camPitch >  1.2) camPitch =  1.2;
        if (camPitch < -1.2) camPitch = -1.2;
        updateCameraPose();
    }
    function dolly(factor)
    {
        camDistScale *= factor;
        if (camDistScale < 0.35) camDistScale = 0.35;
        if (camDistScale > 3.0)  camDistScale = 3.0;
        updateCameraPose();
    }
    function resetCamera()
    {
        camYaw = 0.0; camPitch = 0.0; camDistScale = 1.0;
        updateCameraPose();
    }

    // 視線をカメラ(=プレイヤー)へ向ける。head の高さで、カメラのヨー方向の
    // 「遠方」を見る。遠方にすることで下向き固定や idle での符号ちらつきを防ぎ、
    // 旋回時は水平にプレイヤーを追従する自然な視線になる。
    function applyLookAtCamera()
    {
        var R = 8.0;   // 遠方注視距離
        var tx = headWX + R * Math.sin(camYaw);
        var tz = headWZ + frontZ * R * Math.cos(camYaw);
        vrm.setLookAtTarget(tx, headWY, tz);
    }
    function setLookAtCamera(on)
    {
        lookAtCamera = on;
        if (on) applyLookAtCamera();
        else vrm.clearLookAtTarget();
    }

    // 感情表情を切り替える(前の感情は 0 に戻す)。"" / "neutral" で素の顔。
    // 感情表情を切り替える。前の表情はフェードアウト、新しい表情はフェードインで
    // なめらかに遷移する。"" / "neutral" で素の顔へ。
    function setEmotion(name)
    {
        if (name == "neutral") name = "";
        if (name == emotion) return;
        if (emotion != "") { prevEmotion = emotion; prevW = emoW; }   // 現在のをフェードアウトへ
        emotion = name;
        emoW = 0.0;
        if (emotion != "") {
            // 表情に入る間は自動まばたきを止める(目形が競合して乱れるため)
            vrm.setExpression("blink", 0.0);
            blinkPhase = -1; blinkClock = 0.0;
        }
    }
    // 表情ウェイトの時間補間(毎フレーム)
    function updateExpression(dt)
    {
        var sp = (emoDur > 0.0) ? dt / emoDur : 1.0;
        if (prevEmotion != "") {
            prevW -= sp;
            if (prevW <= 0.0) { prevW = 0.0; vrm.setExpression(prevEmotion, 0.0); prevEmotion = ""; }
            else vrm.setExpression(prevEmotion, prevW);
        }
        if (emotion != "") {
            if (emoW < 1.0) { emoW += sp; if (emoW > 1.0) emoW = 1.0; }
            vrm.setExpression(emotion, emoW);
        }
    }

    function setBlinkEnabled(on)
    {
        blinkEnabled = on;
        if (!on) { vrm.setExpression("blink", 0.0); blinkPhase = -1; }
    }

    // VRMA モーションを再生する。loop=0 は一度再生して最終ポーズを保持(=ポーズ付け)。
    function playMotion(anim, loop)
    {
        if (anim === void) return;
        motionAnim = anim;
        motionDur = anim.getDuration();
        motionTime = 0.0;
        motionLoop = loop;
        motionPlaying = true;
    }
    // モーションを止めて素立ち(腕下ろし)へ戻す
    function stopMotion()
    {
        motionAnim = void;
        motionPlaying = false;
        vrm.resetNormalizedPose();   // 正規化ポーズを rest へ
        restPose();                  // 腕を下ろす
    }

    // 空間モードでの world 配置。offX=左右 / offZ=前後(+z=カメラ側=前)。
    function spaceSet(x, z) { offX = x; offZ = z; vrm.setOffset(offX, 0, offZ); }
    function spaceNudge(dx, dz)
    {
        offX += dx; offZ += dz;
        if (offX < -3.0) offX = -3.0;  if (offX > 3.0) offX = 3.0;
        if (offZ < -3.0) offZ = -3.0;  if (offZ > 3.0) offZ = 3.0;
        vrm.setOffset(offX, 0, offZ);
    }

    // idle 呼吸: 胸を前後に、頭をわずかに揺らして生きてる感を出す。
    // normalized ボーンへ毎フレーム「絶対値」で与える(累積しない)。
    function updateIdle(dt)
    {
        idleT += dt;
        var chest = vrm.getNormalizedBoneNode("upperChest");
        if (chest === void) chest = vrm.getNormalizedBoneNode("chest");
        if (chest === void) chest = vrm.getNormalizedBoneNode("spine");
        if (chest !== void)
            chest.setRotation(0.018 * Math.sin(idleT * 1.6), 0, 0);   // 呼吸(前後)
        // 頭はヨー(左右)を入れると視線がぎょろついて見えるので、ごく僅かな
        // 頷き(ピッチ)のみ。左右揺れは入れない。
        var head = vrm.getNormalizedBoneNode("head");
        if (head !== void)
            head.setRotation(0.006 * Math.sin(idleT * 0.8), 0, 0);
    }
    function setIdleEnabled(on)
    {
        idleEnabled = on;
        if (!on) {
            // 揺れを止めて基準姿勢へ戻す
            var chest = vrm.getNormalizedBoneNode("upperChest");
            if (chest === void) chest = vrm.getNormalizedBoneNode("chest");
            if (chest === void) chest = vrm.getNormalizedBoneNode("spine");
            if (chest !== void) chest.setRotation(0, 0, 0);
            var head = vrm.getNormalizedBoneNode("head");
            if (head !== void) head.setRotation(0, 0, 0);
        }
    }

    // 毎フレーム更新(dt 秒)
    function update(dt)
    {
        if (motionAnim !== void) {
            // VRMA 再生中はモーションが全身ポーズを駆動(idle と競合するので idle 停止)
            if (motionPlaying) {
                motionTime += dt;
                if (motionTime >= motionDur) {
                    if (motionLoop) { motionTime = (motionDur > 0.0) ? motionTime - motionDur : 0.0; }
                    else { motionTime = motionDur; motionPlaying = false; }
                }
            }
            vrm.applyAnimation(motionAnim, motionTime);   // 停止後も最終ポーズを保持
        } else {
            if (idleEnabled) updateIdle(dt);
        }
        updateExpression(dt);
        // 感情表情の遷移中/適用中はまばたきしない(目形の競合回避)
        var faceBusy = (emotion != "" || prevEmotion != "");
        if (blinkEnabled && !faceBusy) updateBlink(dt);
        if (lookAtCamera) applyLookAtCamera();
        vrm.update(dt);
    }

    // 自動まばたきの状態機械
    function updateBlink(dt)
    {
        if (blinkPhase < 0) {
            blinkClock += dt;
            if (blinkClock >= blinkInterval) {
                blinkPhase = 0; blinkTime = 0.0; blinkClock = 0.0;
                // 次の間隔をゆらす(2.4〜5.3秒程度)
                blinkSeed = (blinkSeed * 1103515245 + 12345) & 0x7fffffff;
                blinkInterval = 2.4 + (blinkSeed % 30) / 10.0;
            }
            return;
        }
        var CLOSE = 0.06, OPEN = 0.10;
        blinkTime += dt;
        if (blinkPhase == 0) {
            var wgt = blinkTime / CLOSE;
            if (wgt >= 1.0) { wgt = 1.0; blinkPhase = 1; blinkTime = 0.0; }
            vrm.setExpression("blink", wgt);
        } else {
            var wgt = 1.0 - blinkTime / OPEN;
            if (wgt <= 0.0) { wgt = 0.0; blinkPhase = -1; }
            vrm.setExpression("blink", wgt);
        }
    }

    // 自分の dest レイヤへ 1 回描画する
    function render()
    {
        adaptor.capture(dest, global.tachieRenderCb, this, 0x00000000);
        dest.update();
    }

    function finalize()
    {
        invalidate vrm if vrm !== void;
    }
}

// capture コールバックは adaptor コンテキストで走りクラスメンバが見えないため、
// 必要な参照は param(=Tachie)経由で受ける。グローバル関数として置く。
function tachieRenderCb(w, h, t)
{
    t.renderer.onBeginScene(w, h);
    t.renderer.render(t.scene, t.camera);
    t.renderer.onEndScene();
}
