// webui.tjs — ブラウザ編集 UI 向け WebServer ハンドラ登録 (アプリ層)
//
// advsample (global.app = ADVSample) のモデル層を HTTP/SSE へ橋渡しする。
//   /ui/ 以下     … data/ui/ 以下の静的配信 (ブラウザ UI 本体)
//   /app/state    … 編集状態 JSON (GET)
//   /app/…        … 操作系 (POST, body=JSON)
//   SSE /sub/state … 状態変更の push (操作後に broadcast)
//
// engine が WebServer (-replweb ビルド) を持たない場合は何もしない。
// advsample.tjs 末尾から execStorage される (単体で REPL から呼んでもよい)。
// ハンドラは常にメインスレッドで呼ばれるため app を直接触ってよい。
// ※ TJS2 はローカル関数へのレキシカルクロージャを持たないので、ハンドラは
//    クラスメンバにして objthis (webui インスタンス) 経由で相互参照する。
// ※ TJS2 のブロックコメントはネスト可能で "/ui/" + "*" の並びが誤爆するため
//    このファイルは行コメントのみ使用。

class WebUIBridge
{
    function WebUIBridge() {}

    // ---- 状態 JSON (各編集タブに必要な一式) ----
    function buildState()
    {
        var st = %[];
        if (typeof global.app == "undefined") { st.ready = false; return st; }
        st.ready = true;
        st.workMode = app.workMode;

        // --- 表情編集 ---
        st.editName = (app.editName === void) ? "" : app.editName;
        st.morphs = (app.editMorphs === void) ? %[] : app.editMorphs;
        st.faces = app.faceIdList();
        var groups = [];
        for (var g = 0; g < FACE_MORPH_GROUPS.count; g++) {
            var src = FACE_MORPH_GROUPS[g];
            var items = [];
            for (var i = 0; i < src.items.count; i++)
                items.add(%[ "name" => src.items[i][0], "label" => src.items[i][1] ]);
            groups.add(%[ "title" => src.title, "items" => items ]);
        }
        st.groups = groups;

        // --- ポーズ編集 ---
        var pb = [];
        for (var i = 0; i < POSE_BONES.count; i++)
            pb.add(%[ "name" => POSE_BONES[i][0], "label" => POSE_BONES[i][1] ]);
        st.pose = %[
            "bones" => pb,
            "editBone" => app.editBone,
            "euler" => app.editBoneEuler(),   // 選択ボーンの [rx,ry,rz] (度)
            "hips" => [ app.editHips[0], app.editHips[1], app.editHips[2] ],
            "poses" => app.poseIdList(),
            "poseName" => (app.poseName === void) ? "" : app.poseName
        ];

        // --- 連番(シーケンス) ---
        var steps = [];
        if (app.seq !== void) {
            for (var i = 0; i < app.seq.count; i++) {
                var s = app.seq[i];
                steps.add(%[ "pose" => s.pose, "hold" => s.hold, "trans" => s.trans,
                             "expr" => (s.expr === void) ? "" : s.expr ]);
            }
        }
        var emo = [];
        var en = app.emotionNames();
        for (var i = 0; i < en.count; i++)
            emo.add(%[ "name" => en[i], "label" => app.exprLabel(en[i]) ]);
        st.seq = %[ "steps" => steps, "sel" => app.seqSel, "emotes" => emo ];

        // --- キャラ管理 ---
        if (app.charReg !== void) {
            var ids = app.charReg.idList();
            var list = [];
            for (var i = 0; i < ids.count; i++) {
                var e = app.charReg.find(ids[i]);
                list.add(%[ "id" => ids[i],
                            "name" => (e !== void && e.name !== void) ? e.name : ids[i] ]);
            }
            st.chars = %[ "list" => list, "slots" => app.charReg.slots,
                          "sel" => app.charSel,
                          "slotNames" => [ app.slotName(0), app.slotName(1) ] ];
        }
        return st;
    }
    function stateJson() { return Scripts.toJSONString(buildState()); }
    function push() { WebServer.broadcast("state", stateJson()); }

    // ---- アプリ操作ハンドラ (WebServer.register の呼び先) ----
    function handler(req)
    {
        var path = req.path;
        if (path == "/app/state") return stateJson();

        if (typeof global.app == "undefined")
            return %[ "status" => 503, "body" => "{\"error\":\"app not ready\"}" ];

        var arg = (req.body != "") ? Scripts.evalJSON(req.body) : %[];

        if (path == "/app/workmode") {          // {mode:"op"/"face"/"pose"/"seq"/"char"}
            app.setWorkMode(arg.mode);
            push();
            return "{\"ok\":true}";
        }

        // --- 表情編集 ---
        if (path == "/app/face/morph") {        // {name:"Fcl_…", w:0..1} スライダライブ反映
            app.editSetMorph(arg.name, +arg.w);
            return "{\"ok\":true}";             // 連打されるので push しない (操作元が真実)
        }
        if (path == "/app/face/clear") {        // 全モーフ 0
            app.editClear();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/face/save") {         // {id:"表情名"} 現在の編集内容を保存
            app.editName = arg.id;
            app.saveCurrentFace();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/face/load") {         // {id:"表情名"} ライブラリから編集へ読込
            app.loadFaceIntoEdit(arg.id);
            push();
            return "{\"ok\":true}";
        }

        // --- ポーズ編集 ---
        if (path == "/app/pose/base") {         // {kind:"capture"|"rest"} 基準姿勢を採取
            if (arg.kind == "rest") app.poseBaseRest();
            else app.poseBaseCapture();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/pose/bone") {         // {name:"head"…} 編集対象ボーン切替
            app.editSelectBone(arg.name);
            push();                             // euler が変わるので配信
            return "{\"ok\":true}";
        }
        if (path == "/app/pose/rot") {          // {axis:0-2, deg:-180..180} 回転ライブ反映
            app.editSetBoneRot(+arg.axis, +arg.deg);
            return "{\"ok\":true}";             // スライダ連打のため push しない
        }
        if (path == "/app/pose/hips") {         // {axis:0-2, m:-0.5..0.5} hips 移動
            app.editSetHips(+arg.axis, +arg.m);
            return "{\"ok\":true}";
        }
        if (path == "/app/pose/save") {         // {id:"ポーズ名"}
            app.poseName = arg.id;
            app.saveCurrentPose();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/pose/load") {         // {id:"ポーズ名"}
            app.loadPoseIntoEdit(arg.id);
            push();
            return "{\"ok\":true}";
        }

        // --- 連番(シーケンス) ---
        if (path == "/app/seq/add") {           // {id:"ポーズ名"} 手順を末尾へ追加
            app.seqAddPose(arg.id);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/select") {        // {i:index}
            app.seqSelectStep(+arg.i);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/hold") {          // {sec:0..3} 選択手順の保持秒 (スライダ)
            app.seqSetHold(+arg.sec);
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/trans") {         // {sec:0..3} 選択手順の遷移秒 (スライダ)
            app.seqSetTrans(+arg.sec);
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/expr") {          // {name:"happy"…/"none"} 選択手順の表情
            app.seqSetExpr(arg.name);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/move") {          // {dir:-1/1} 選択手順を並べ替え
            app.seqMoveStep(+arg.dir);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/del") {           // 選択手順を削除
            app.seqDelStep();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/clear") {         // 全消去 (再生も停止)
            app.seqClear();
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/preview") {       // ループ再生
            app.seqPreview();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/stop") {          // 停止
            app.seqStop();
            return "{\"ok\":true}";
        }
        if (path == "/app/seq/export") {        // {file?:"poseseq.vrma"} VRMA 書出
            var f = (arg.file !== void && arg.file != "") ? arg.file : "poseseq.vrma";
            var ok = app.seqExportVRMA(f);
            return "{\"ok\":" + (ok ? "true" : "false") + ",\"file\":\"" + f + "\"}";
        }

        // --- キャラ管理 ---
        if (path == "/app/char/select") {       // {id}
            app.selectChar(arg.id);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/char/assign") {       // {slot:0/1, id?} id 省略時は選択中
            var id = (arg.id !== void && arg.id != "") ? arg.id : app.charSel;
            app.assignSlot(+arg.slot, id);
            push();
            return "{\"ok\":true}";
        }
        if (path == "/app/char/register") {     // {id,name,vrm,frontZ:1/-1}
            app.regId = (arg.id === void) ? "" : arg.id;
            app.regName = (arg.name === void) ? "" : arg.name;
            app.regVrm = (arg.vrm === void) ? "" : arg.vrm;
            app.regFrontZ = (+arg.frontZ < 0) ? -1 : 1;
            app.registerCharAction();
            push();
            return "{\"ok\":true}";
        }

        return %[ "status" => 404, "body" => "{\"error\":\"unknown: " + path + "\"}" ];
    }
}

(function() {
    if (typeof global.WebServer == "undefined") return;
    // ブラウザ UI 本体 (data/ui/ 以下) を /ui/ で配信 (json.dll 非依存)
    WebServer.serveStatic("/ui/", "ui/");
    // /app/ ブリッジは JSON I/O が要る。未リンクなら自力でリンクを試みる
    // (advsample 以外のビューアモード起動では advsample.tjs のリンクを通らないため)。
    if (typeof Scripts.toJSONString == "undefined") {
        try { Plugins.link("json.dll"); } catch (e) { }
    }
    if (typeof Scripts.toJSONString == "undefined") {
        Debug.message("webui: json.dll がリンクできません → /ui/ のみ登録 (/app/ 無効)");
        return;
    }
    // ハンドラ登録 (webui インスタンスの handle 閉包。objthis=webui でメンバ解決)
    global.webui = new WebUIBridge();
    WebServer.register("/app/", webui.handler);
    Debug.message("webui: WebServer へ /ui/ と /app/ を登録");
})();
