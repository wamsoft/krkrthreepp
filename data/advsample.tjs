/**
 * advsample.tjs — 1920x1080 ADV/編集ツール風サンプル (VRM 立ち絵2体)
 *
 * 起動:  krkrz64.exe <data> -readencoding=UTF-8 -sample
 *   (startup.tjs が -sample を見て本スクリプトを実行する)
 *
 * 編集 IDE 風の 4 ペイン構成:
 *   左  : コマンド/対象選択パネル(Elements 常駐オーバーレイ。font_scale で拡大、
 *         セクションは group タイトルバー + 兄弟ボタンで見出し表示)
 *   中央: 3D ビューポート(1280x720)。VRM 立ち絵を 2 体、共有 GLESAdaptor +
 *         GLRenderer が各 dest レイヤへ個別に描画する。
 *   右  : インスペクター(選択対象キャラの状態を強調表示)
 *   下  : ログ/情報コンソール(タイトル・状態・キーヒント・操作ログ)
 *
 * 各種動作(フレーミング/表情/モーション/まばたき/リップ等)はブラウザ編集UI (/ui/) で操作。
 * REPL/Agent 用グローバル: global.app (ADVSample), global.win(=app 別名)。
 */

Scripts.execStorage("vrmframing.tjs");
Scripts.execStorage("tachie.tjs");
Scripts.execStorage("charreg.tjs");

// 状態のファイル保存用(Dictionary.saveStruct)。無くても動く(メモリ保存にフォールバック)。
try { Plugins.link("saveStruct.dll"); } catch (e) { }
// JSON 読み書き(Scripts.evalJSON/evalJSONStorage/saveJSON/toJSONString)。
// 表情ライブラリ(faces.json)をブラウザ three-vrm エディタと共有する形式で保存する。
try { Plugins.link("json.dll"); } catch (e) { }

// ---------------------------------------------------------------------------
//  表情編集(生モーフ簡易エディタ)用の curated モーフ定義
// ---------------------------------------------------------------------------
// VRoid の 57 生モーフ(Fcl_*)のうち、表情づくりで使う代表的なものをグループ化。
// 「簡易モード」はこの curated セットをスライダで編集する(全 57 は詳細モードで)。
// 各要素: [Fcl名, 表示ラベル]。id は "mo:" + Fcl名 でパネルとやりとりする。
var FACE_MORPH_GROUPS = [
    %[ "title" => "眉", "items" => [
        [ "Fcl_BRW_Angry", "怒" ], [ "Fcl_BRW_Fun", "楽" ], [ "Fcl_BRW_Joy", "喜" ],
        [ "Fcl_BRW_Sorrow", "哀" ], [ "Fcl_BRW_Surprised", "驚" ] ] ],
    %[ "title" => "目", "items" => [
        [ "Fcl_EYE_Close", "閉" ], [ "Fcl_EYE_Close_L", "閉L" ], [ "Fcl_EYE_Close_R", "閉R" ],
        [ "Fcl_EYE_Joy", "笑" ], [ "Fcl_EYE_Sorrow", "哀" ], [ "Fcl_EYE_Surprised", "驚" ],
        [ "Fcl_EYE_Spread", "見開" ] ] ],
    %[ "title" => "口", "items" => [
        [ "Fcl_MTH_A", "あ" ], [ "Fcl_MTH_I", "い" ], [ "Fcl_MTH_U", "う" ],
        [ "Fcl_MTH_E", "え" ], [ "Fcl_MTH_O", "お" ], [ "Fcl_MTH_Fun", "楽" ],
        [ "Fcl_MTH_Joy", "喜" ], [ "Fcl_MTH_Sorrow", "哀" ], [ "Fcl_MTH_Large", "大" ],
        [ "Fcl_MTH_Small", "小" ] ] ],
    %[ "title" => "頬", "items" => [
        [ "Fcl_MTH_SkinFung", "ほお" ] ] ]
];
// 表情ライブラリの保存先(共有 JSON。ブラウザエディタと相互運用)。
var FACE_LIB_FILE = "faces.json";

// Dictionary を [key, val, key, val, …] の配列へ(TJS は for-in 不可なので
// Array.assign(dict) で列挙する)。d が void なら空配列。
function dictPairs(d)
{
    var a = [];
    if (d !== void && d !== null) (a.assign incontextof a)(d);
    return a;
}

// ---------------------------------------------------------------------------
//  ポーズ編集(簡易エディタ)用の curated ボーン定義 + 回転変換
// ---------------------------------------------------------------------------
// 正規化ヒューマノイドボーンのうち、立ち絵ポーズで調整する代表的なものを列挙。
// [ボーン名, 表示ラベル]。id は "pb:" + ボーン名 でパネルとやりとりする。
var POSE_BONES = [
    [ "head", "頭" ], [ "neck", "首" ], [ "chest", "胸" ], [ "spine", "背" ], [ "hips", "腰" ],
    [ "rightUpperArm", "右腕" ], [ "rightLowerArm", "右肘" ], [ "rightHand", "右手" ],
    [ "leftUpperArm", "左腕" ], [ "leftLowerArm", "左肘" ], [ "leftHand", "左手" ],
    [ "rightUpperLeg", "右脚" ], [ "leftUpperLeg", "左脚" ]
];
// ポーズライブラリの保存先(共有 JSON。ブラウザ three-vrm エディタと相互運用)。
var POSE_LIB_FILE = "poses.json";
var DEG2RAD = 3.14159265358979 / 180.0;
var RAD2DEG = 180.0 / 3.14159265358979;

// オイラー角(度, XYZ)→ クオータニオン [qx,qy,qz,qw]
function eulerToQuat(rx, ry, rz)
{
    var e = new Threepp.Euler(rx * DEG2RAD, ry * DEG2RAD, rz * DEG2RAD);
    var q = new Threepp.Quaternion(0, 0, 0, 1);
    q.setFromEuler(e, 1);
    return [ q.x, q.y, q.z, q.w ];
}
// クオータニオン → オイラー角(度, XYZ)[rx,ry,rz]
function quatToEuler(qx, qy, qz, qw)
{
    var q = new Threepp.Quaternion(qx, qy, qz, qw);
    var e = new Threepp.Euler(0, 0, 0);
    e.setFromQuaternion(q);
    return [ e.x * RAD2DEG, e.y * RAD2DEG, e.z * RAD2DEG ];
}

// 3D 描画領域(中央ビューポート)のサイズ
var SCREEN_W = 1280;
var SCREEN_H = 720;
// ウィンドウ全体。3 ペイン構成 (編集 UI はブラウザ側 /ui/ に移行済み):
//   左〜中央: 3D ビューポート(1280x720)
//   右      : インスペクター(選択対象の状態表示)
//   下      : ログ/情報コンソール(ビューポートの下)
var WIN_W = 1920;
var WIN_H = 1080;
var RENDER_X = 0;                   // ビューポートは左端から
var RENDER_Y = 0;
// 右: インスペクター(ビューポートの右、フル高)
var INSP_X   = SCREEN_W;            // = 1280
var INSP_Y   = 0;
var INSP_W   = WIN_W - SCREEN_W;    // = 640
var INSP_H   = WIN_H;               // 1080
// 下: ログ/情報コンソール(ビューポートの真下)
var LOG_X    = 0;
var LOG_Y    = SCREEN_H;            // 720
var LOG_W    = SCREEN_W;            // 1280
var LOG_H    = WIN_H - SCREEN_H;    // 360

// 立ち絵1体分の描画バッファ(=dest レイヤ)サイズ。両キャラ共通なので
// adaptor/renderer をこのサイズ固定で使え、フレーム毎のリサイズが要らない。
// キャラを横に十分な余白付きで収め(T字腕でも切れない)、左右レイヤを
// オーバーラップさせて配置する(ltAlpha 透明なので重ねても問題ない)。
var TACHIE_W = 720;
var TACHIE_H = 720;
// 各キャラの dest レイヤ左上位置(キャラは各レイヤ中央に立つ)。中央付近で重なる。
var LEFT_X  = -30;
var RIGHT_X = 590;

// 空間モードのカメラ画角。狭い(望遠)ほど投影が平行に近づき、寄せても左右の
// キャラが外向きに歪みにくい。
var SPACE_FOV = 20;

// ---------------------------------------------------------------------------
//  視線ターゲット用のドラッグ可能レイヤ (最前面・全面ヒット)
// ---------------------------------------------------------------------------
class GazeLayer extends Layer
{
    var app;
    var dragging = false;

    function GazeLayer(win, parent, app)
    {
        super.Layer(win, parent);
        this.app = app;
    }
    function onMouseDown(x, y, button, shift)
    {
        if (button == mbLeft) { dragging = true; app.setGaze(x, y); }
    }
    function onMouseMove(x, y, shift)
    {
        if (dragging) app.setGaze(x, y);
    }
    function onMouseUp(x, y, button, shift)
    {
        if (button == mbLeft) dragging = false;
    }
}

// ---------------------------------------------------------------------------
//  ADV サンプル本体
// ---------------------------------------------------------------------------
class ADVSample extends Window
{
    var adaptor;    // 共有 GLESAdaptor
    var renderer;   // 共有 Threepp.GLRenderer
    var framer;     // 共有 VRMFraming

    var baseLayer;  // 全窓ベース(1920x1080, 4ペインの余白)
    var back;       // 3D ビューポート(1280x720, 中央)。全描画レイヤの親
    var inspLayer;  // 右: インスペクター(選択対象の状態)
    var logLayer;   // 下: ログ/情報コンソール
    var tachies;    // Tachie 配列 [左, 右]
    var target = 2; // 操作対象 0:左 1:右 2:両方

    var timer, lastTick;
    var logLines;   // 情報欄の操作ログ(リング)
    var infoClock = 0.0;

    // --- 作業モード(ブラウザ編集UIのペイン切替軸。view の tachie/space とは直交) ---
    // "op"  : 通常操作(対象/フレーム/表情/モーション/…)
    // "face": 表情編集(生モーフ簡易エディタ。curated モーフをスライダ編集→JSON保存)
    // "pose": ポーズ編集(採取/素立ちから関節回転をスライダ編集→JSON保存)
    var workMode = "op";
    var editMorphs;    // 編集中の生モーフ %[Fcl名 => weight(0..1)]
    var editName = ""; // 編集中の表情名(キーワード)
    var faceLib;       // 表情ライブラリ %[id => %[label, morphs:%[Fcl名=>w]]]
    // ポーズ編集
    var editPose;      // 編集中のポーズ %[ボーン名 => [qx,qy,qz,qw]]
    var editHips = [ 0.0, 0.0, 0.0 ];  // hips ルートモーション オフセット [dx,dy,dz]
    var editBone = "head"; // 回転スライダの対象ボーン
    var poseName = "";     // 編集中のポーズ名(キーワード)
    var poseLib;           // ポーズライブラリ %[id => %[label, bones:%[…], hips:[dx,dy,dz]]]
    // キャラ管理(レジストリ)
    var charReg;           // CharRegistry(chars/registry.json)
    var slotDefs;          // 各スロットに割当中の char.json 定義 [左, 右]
    var charSel = "";      // キャラ管理パネルで選択中の id
    var regId = "", regName = "", regVrm = "";   // 新規登録フォームの入力値
    var regFrontZ = 1;                            // 新規登録の正面(+1/-1)

    // --- モード ---
    // "tachie": 現行(1キャラ=1レイヤ・各自カメラ) / "space": 単一カメラで空間に並べて
    // 1枚のフルスクリーンレイヤへ描画、背景はカメラ追従ビルボード。
    var mode = "tachie";
    var spaceScene, spaceCamera, spaceDest, spaceBg, spaceBgLayer;
    // 舞台(書割の前で演技)イメージ: 望遠で寄り気味の既定。
    var sCamYaw = 0.0, sCamPitch = 0.02, sCamDist = 3.8;   // 空間カメラ軌道
    var sTX = 0.0, sTY = 1.0, sTZ = 0.0;                   // 空間カメラ注視点
    var sFov = SPACE_FOV;                                  // 空間カメラ画角(望遠/広角)
    var sCamMode = "orbit";   // "orbit"(回り込み) / "move"(平行移動)
    var bgFollow = false;     // 背景板 false=舞台奥に固定 / true=カメラ追従(常に画面を埋める)

    // --- 視線ターゲット(ドラッグで視線追従を確認) ---
    var gazeLayer;
    var gazeActive = false;
    var gazeX = SCREEN_W / 2, gazeY = SCREEN_H / 2;

    // --- 舞台メタ定義 / VRMA モーション / シーン ---
    var stageDef;      // stage.tjs の global.stageDef
    var motionCache;   // file -> Threepp.VRMAnimation
    var motionBtnMap;  // パネル id("m_*") -> motion 定義
    var motionById;    // motion id -> 定義
    var sceneBtnMap;   // パネル id("sc_*") -> scene 定義
    var savedState;    // セーブした状態(復元用)
    var poseSlots;     // ポーズ名 -> [name,qx,qy,qz,qw,…]。"cap"=採取スロット

    function ADVSample()
    {
        super.Window();
        caption = "krkr_threepp ADV sample";
        setInnerSize(WIN_W, WIN_H);

        // 全窓ベース(L字の空き領域を暗色で埋める)
        baseLayer = new Layer(this, null);
        baseLayer.setImageSize(WIN_W, WIN_H);
        baseLayer.setSize(WIN_W, WIN_H);
        baseLayer.setPos(0, 0);
        baseLayer.fillRect(0, 0, WIN_W, WIN_H, 0xFF12141E);
        baseLayer.visible = true;
        add(baseLayer);

        // 右: インスペクター(選択対象の状態表示・右列フル高)
        logLines = [];
        inspLayer = new Layer(this, baseLayer);
        inspLayer.setImageSize(INSP_W, INSP_H);
        inspLayer.setSize(INSP_W, INSP_H);
        inspLayer.setPos(INSP_X, INSP_Y);
        inspLayer.visible = true;

        // 下: ログ/情報コンソール(中央ビューの真下)
        logLayer = new Layer(this, baseLayer);
        logLayer.setImageSize(LOG_W, LOG_H);
        logLayer.setSize(LOG_W, LOG_H);
        logLayer.setPos(LOG_X, LOG_Y);
        logLayer.visible = true;

        // 3D 描画領域(右上)。全描画レイヤ(dest/space/gaze)はこの back の子。
        back = new Layer(this, baseLayer);
        back.setImageSize(SCREEN_W, SCREEN_H);
        back.setSize(SCREEN_W, SCREEN_H);
        back.setPos(RENDER_X, RENDER_Y);
        drawBackground(back);
        back.visible = true;
        add(back);

        // 共有 GLES コンテキスト & レンダラ (立ち絵1体分のサイズで固定)
        adaptor = new GLESAdaptor(this);
        adaptor.setScreenSize(TACHIE_W, TACHIE_H);
        adaptor.unpremultiply = true;
        adaptor.makeCurrent();
        renderer = new Threepp.GLRenderer(adaptor, TACHIE_W, TACHIE_H);
        renderer.setClearColor(0x000000, 0.0);

        framer = new VRMFraming();

        // 立ち絵2体を左右に。1キャラ=1レイヤで setPos 配置。
        // 舞台メタ定義(モーション/表情/シーン)を読む
        Scripts.execStorage("stage.tjs");
        stageDef = global.stageDef;
        motionCache = %[];
        buildMotionMap();

        // キャラクターレジストリ(chars/registry.json)。無ければ stage.tjs の
        // characters を seed に新規作成する。以降キャラの読込はレジストリ起点。
        charReg = new CharRegistry();
        charReg.load(stageDef.characters);
        slotDefs = [void, void];

        // スロット割当(registry.slots)のキャラを左右に生成
        tachies = [];
        var xs = [LEFT_X, RIGHT_X];
        for (var i = 0; i < 2; i++) {
            var t = new Tachie(this, adaptor, renderer, framer, back, TACHIE_W, TACHIE_H);
            var def = charReg.loadCharDef(charReg.slots[i]);
            if (def !== void) {
                t.load(def.vrm, def.frontZ, xs[i], 0);
                slotDefs[i] = def;
            }
            tachies.add(t);
        }

        // 既定フレーミング(腰上。頭は全部出て足は隠れる ADV 立ち絵構図)
        applyFrame("waist");

        // 描画ループ
        lastTick = System.getTickCount();
        timer = new Timer(this, "onFrame");
        timer.interval = 16;
        timer.enabled = true;
        add(timer);
    }

    // Tab でブラウザ編集 UI を開く。矢印でカメラ旋回、Z/X でズーム(操作対象に適用)。
    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_TAB:
            if (typeof global.webui != "undefined") webui.openBrowser();
            return;
        case VK_LEFT:  cameraOrbit(-0.12, 0.0);  return;
        case VK_RIGHT: cameraOrbit( 0.12, 0.0);  return;
        case VK_UP:    cameraOrbit( 0.0,  0.08); return;
        case VK_DOWN:  cameraOrbit( 0.0, -0.08); return;
        case VK_Z:     cameraDolly(1.0 / 1.1);   return;
        case VK_X:     cameraDolly(1.1);         return;
        case VK_R:     cameraReset();            return;
        }
        super.onKeyDown(key, shift);
    }

    function drawBackground(layer)
    {
        // 縦グラデ + 床ライン。ADV の背景想定のあっさり塗り。
        for (var y = 0; y < SCREEN_H; y++) {
            var t = y * 1.0 / SCREEN_H;
            var r = (int)(0x28 + 0x20 * t);
            var g = (int)(0x2c + 0x2a * t);
            var b = (int)(0x3a + 0x36 * t);
            layer.fillRect(0, y, SCREEN_W, 1, 0xFF000000 + (r << 16) + (g << 8) + b);
        }
        // 床っぽい水平線
        layer.fillRect(0, (int)(SCREEN_H * 0.82), SCREEN_W, 2, 0x30FFFFFF);
    }

    // ==================================================================
    //  空間モード (単一カメラ + 背景ビルボード)
    // ==================================================================
    // 空間用の背景をレイヤへ描く(ビルボードのテクスチャ元)。あっさりした
    // 屋内風グラデ + 床。将来は画像差し替え。
    function drawSpaceBg(layer)
    {
        var W = layer.imageWidth, H = layer.imageHeight;
        var horizon = (int)(H * 0.62);
        for (var y = 0; y < H; y++) {
            var c;
            if (y < horizon) {           // 壁
                var t = y * 1.0 / horizon;
                var r = (int)(0x3a + 0x18 * t), g = (int)(0x36 + 0x1a * t), b = (int)(0x42 + 0x20 * t);
                c = 0xFF000000 + (r << 16) + (g << 8) + b;
            } else {                     // 床
                var t2 = (y - horizon) * 1.0 / (H - horizon);
                var r2 = (int)(0x2a - 0x10 * t2), g2 = (int)(0x24 - 0x0e * t2), b2 = (int)(0x28 - 0x10 * t2);
                c = 0xFF000000 + (r2 << 16) + (g2 << 8) + b2;
            }
            layer.fillRect(0, y, W, 1, c);
        }
        layer.fillRect(0, horizon, W, 2, 0x40FFFFFF);   // 地平線
    }

    // 背景ビットマップをレイヤへ読み込む(成功で true)。textureFromLayer の元にする。
    function loadBgImage(layer, name)
    {
        try {
            layer.loadImages(name);   // 画像サイズにレイヤがリサイズされる
            return true;
        } catch (e) {
            Debug.message("bg image load failed: " + name);
            return false;
        }
    }

    // 空間シーンを初回だけ構築する
    function buildSpace()
    {
        if (spaceScene !== void) return;
        spaceScene  = new Threepp.Scene();
        spaceCamera = new Threepp.PerspectiveCamera(sFov, SCREEN_W * 1.0 / SCREEN_H, 0.1, 100);

        var dir = new Threepp.DirectionalLight(0xffffff, 1.25);
        dir.setPosition(0.5, 1.0, 1.0); spaceScene.add(dir);
        var amb = new Threepp.AmbientLight(0xffffff, 0.8); spaceScene.add(amb);

        // 背景ビルボード (書割): 背景ビットマップをレイヤへ読み込み → テクスチャ → 平面 Mesh
        spaceBgLayer = new Layer(this, back);
        spaceBgLayer.visible = false;
        if (!loadBgImage(spaceBgLayer, "bg.jpg")) {
            // 読み込めなければ生成グラデにフォールバック
            spaceBgLayer.setImageSize(1024, 576);
            spaceBgLayer.setSize(1024, 576);
            drawSpaceBg(spaceBgLayer);
        }
        var tex  = textureFromLayer(spaceBgLayer);
        var bmat = new Threepp.MeshBasicMaterial();
        bmat.setMap(tex);
        var bgeo = new Threepp.PlaneGeometry(1, 1);
        spaceBg  = new Threepp.Mesh(bgeo, bmat);
        spaceScene.add(spaceBg);

        // フルスクリーンの描画先レイヤ
        spaceDest = new Layer(this, back);
        spaceDest.setImageSize(SCREEN_W, SCREEN_H);
        spaceDest.setSize(SCREEN_W, SCREEN_H);
        spaceDest.setPos(0, 0);
        spaceDest.type = ltAlpha;
        spaceDest.visible = false;
        add(spaceDest);

        updateSpaceCamera();
    }

    // 注視点まわりの旋回/ズームから空間カメラを置く
    function updateSpaceCamera()
    {
        var cp = Math.cos(sCamPitch);
        var px = sTX + sCamDist * Math.sin(sCamYaw) * cp;
        var py = sTY + sCamDist * Math.sin(sCamPitch);
        var pz = sTZ + sCamDist * Math.cos(sCamYaw) * cp;
        spaceCamera.setPosition(px, py, pz);
        spaceCamera.lookAt(sTX, sTY, sTZ);
        spaceCamera.updateProjectionMatrix();
    }

    // 背景板の更新。bgFollow=false: 舞台奥に固定した板(カメラ移動で自然に見え方が
    // 変わる)。bgFollow=true: カメラ追従で常に画面を埋める書割。
    // ※ textureFromLayer は上下反転しない(threepp の flipY はローダ側)ため、
    //   どちらも平面の Y を負スケールにして上下を正す。
    function updateSpaceBg()
    {
        if (spaceBg === void) return;
        if (!bgFollow) {
            // 舞台奥の固定板 (16:9)。床(y=0)付近から立てる。+Z(客席)向き。
            spaceBg.setPosition(0.0, 2.4, -3.5);
            spaceBg.setRotation(0, 0, 0);
            spaceBg.setScale(10.0, -5.6, 1.0);
            return;
        }
        // カメラ追従(常に画面を埋める)
        var cp = spaceCamera.position;   // Vector3
        var fx = sTX - cp.x, fy = sTY - cp.y, fz = sTZ - cp.z;   // カメラ→注視(前方)
        var fl = Math.sqrt(fx*fx + fy*fy + fz*fz); if (fl < 0.001) fl = 1;
        fx /= fl; fy /= fl; fz /= fl;
        var D = 9.0;   // 注視点から奥へ
        var bx = sTX + fx*D, by = sTY + fy*D, bz = sTZ + fz*D;
        spaceBg.setPosition(bx, by, bz);
        // three.js の Mesh.lookAt は +Z をターゲットへ向ける → カメラ位置を直接見る。
        spaceBg.lookAt(cp.x, cp.y, cp.z);
        var camToBg = sCamDist + D;
        var fov = sFov * Math.PI / 180.0;
        var hh = 2.0 * camToBg * Math.tan(fov * 0.5) * 1.08;
        spaceBg.setScale(hh * (SCREEN_W * 1.0 / SCREEN_H), -hh, 1.0);
    }

    // モード切替
    function setMode(m)
    {
        if (m == mode) return;
        if (m == "space") {
            buildSpace();
            for (var i = 0; i < tachies.count; i++) {
                var t = tachies[i];
                spaceScene.add(t.vrm.getScene());          // 空間へ移設
                t.spaceSet((i == 0) ? -0.6 : 0.6, 0.0);    // 左右に並べる(rig ごと)
                t.setLookAtCamera(false);                  // 視線は一旦素に
                t.dest.visible = false;
            }
            spaceDest.visible = true;
            adaptor.setScreenSize(SCREEN_W, SCREEN_H);
            updateSpaceCamera();
        } else {
            for (var i = 0; i < tachies.count; i++) {
                var t = tachies[i];
                t.scene.add(t.vrm.getScene());          // 立ち絵シーンへ戻す
                t.spaceSet(0, 0);
                t.tw = false;                           // 演出トゥイーン解除
                t.dest.opacity = 255;
                t.dest.setPos(t.baseX, t.baseY);
                t.dest.visible = true;
                t.frame(t.preset);                      // カメラ再フレーミング
            }
            if (spaceDest !== void) spaceDest.visible = false;
            adaptor.setScreenSize(TACHIE_W, TACHIE_H);
        }
        mode = m;
        // モードごとに操作パネルを組み替える
    }

    // 空間カメラの画角(望遠/広角)を変える
    function setFov(f)
    {
        if (f < 8)  f = 8;
        if (f > 60) f = 60;
        sFov = f;
        if (spaceCamera !== void) { spaceCamera.fov = sFov; spaceCamera.updateProjectionMatrix(); }
    }
    // 空間モードでの選択キャラの配置
    function moveChar(dx, dz)
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].spaceNudge(dx, dz);
    }
    function resetCharPos()
    {
        tachies[0].spaceSet(-0.6, 0.0);
        tachies[1].spaceSet( 0.6, 0.0);
    }

    // リップシンク: テスト音声を再生し、対象キャラの口を音声から駆動する。
    // 実 ADV では「ボイス再生」箇所で同じ WaveSoundBuffer を tachie.startLipSync() に渡す。
    var voiceSnd;                    // 共有音声バッファ(遅延生成)
    var voiceFile = "testvoice.ogg"; // data/ 配下(非コミットのテスト音声)
    function lipPlay()
    {
        if (voiceSnd === void) voiceSnd = new WaveSoundBuffer(this);
        voiceSnd.useVisBuffer = true;          // 解析バッファを有効化
        try { voiceSnd.open(voiceFile); voiceSnd.play(); }
        catch (e) { Debug.message("lip: 音声を開けません " + voiceFile + " : " + e.message); return; }
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].startLipSync(voiceSnd);
    }
    function lipStop()
    {
        if (voiceSnd !== void) voiceSnd.stop();
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].stopLipSync();
    }

    // 立ち絵演出(dest レイヤのトゥイーン。立ち絵モードで見える)
    function fxFadeIn()  { var list = targetList(); for (var i = 0; i < list.count; i++) list[i].fadeIn(0.5); }
    function fxFadeOut() { var list = targetList(); for (var i = 0; i < list.count; i++) list[i].fadeOut(0.5); }
    function fxSlideIn()
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) {
            var t = list[i];
            var dx = (t == tachies[0]) ? -240 : 240;   // 左は左から/右は右から登場
            t.slideIn(0.6, dx);
        }
    }

    // --- VRMA モーション --------------------------------------------------
    function buildMotionMap()
    {
        motionBtnMap = %[];
        motionById = %[];
        var ms = stageDef.motions;
        for (var i = 0; i < ms.count; i++) { motionBtnMap["m_" + ms[i].id] = ms[i]; motionById[ms[i].id] = ms[i]; }
        sceneBtnMap = %[];
        var sc = stageDef.scenes;
        if (sc !== void) for (var i = 0; i < sc.count; i++) sceneBtnMap["sc_" + sc[i].id] = sc[i];
        exprCompositeById = %[];
        var ex = stageDef.expressions;
        if (ex !== void) for (var i = 0; i < ex.count; i++) exprCompositeById[ex[i].id] = ex[i];
        poseSlots = %[];
        var ps = stageDef.poses;   // メタ定義のポーズ(あれば)
        if (ps !== void) for (var i = 0; i < ps.count; i++) poseSlots[ps[i].id] = ps[i].data;
    }

    // --- ポーズ(採取/適用/保存/読込) -------------------------------------
    function capturePoseAction()
    {
        var list = targetList();
        if (list.count == 0) return;
        poseSlots["cap"] = list[0].capturePose();   // 先頭対象の現在姿勢を採取
        Debug.message("pose captured");
    }
    function applyPoseSlot(name)
    {
        var arr = poseSlots[name];
        if (arr === void) return;
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].applyPoseData(arr);
    }
    function clearPoseAction()
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].clearPose();
    }
    var poseFile = "pose_cap.txt";
    function savePoseAction()
    {
        var arr = poseSlots["cap"];
        if (arr === void) return;
        try { (Array.saveStruct incontextof arr)(poseFile); Debug.message("pose saved: " + poseFile); }
        catch (e) { Debug.message("pose save failed: " + e.message); }
    }
    function loadPoseAction()
    {
        try { if (Storages.isExistentStorage(poseFile)) poseSlots["cap"] = Scripts.evalStorage(poseFile); } catch (e) { }
        applyPoseSlot("cap");
    }
    // VRMA を読み込んでキャッシュ(初回のみ)
    function loadMotion(file)
    {
        if (motionCache[file] !== void) return motionCache[file];
        var loader = new Threepp.VRMAnimationLoader();
        var anim = loader.loadStorage(Storages.getPlacedPath(file));
        if (anim !== void) motionCache[file] = anim;
        else Debug.message("motion load failed: " + file);
        return anim;
    }
    // poseseq モーションの keys を解決([%[data/isRest,in,hold],…])
    function resolveSeqKeys(def)
    {
        var keys = [];
        for (var i = 0; i < def.keys.count; i++) {
            var k = def.keys[i];
            var rk = %[ "in" => k.in, "hold" => k.hold ];
            if (k.pose == "rest") rk["isRest"] = 1;
            else {
                var d = poseSlots[k.pose];
                if (d === void) rk["isRest"] = 1;   // 未定義ポーズは素立ち扱い
                else rk["data"] = d;
            }
            keys.add(rk);
        }
        return keys;
    }
    function playMotionOnTargets(def)
    {
        var list = targetList();
        if (def.type == "poseseq") {
            var keys = resolveSeqKeys(def);
            for (var i = 0; i < list.count; i++) list[i].playPoseSeq(keys, def.loop);
            return;
        }
        var anim = loadMotion(def.file);
        if (anim === void) return;
        for (var i = 0; i < list.count; i++) list[i].playMotion(anim, def.loop, def.id);
    }
    function stopMotionOnTargets()
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].stopMotion();
    }
    // モーション id を指定キャラへ再生("none"/"" は停止)
    function playMotionForChar(t, mid)
    {
        if (mid == "none" || mid == "") { t.stopMotion(); return; }
        var def = motionById[mid];
        if (def === void) return;
        if (def.type == "poseseq") { t.playPoseSeq(resolveSeqKeys(def), def.loop); return; }
        var anim = loadMotion(def.file);
        if (anim !== void) t.playMotion(anim, def.loop, def.id);
    }

    // --- シーン(宣言的な複数キャラ状態) -----------------------------------
    // 1キャラ分の状態を適用(省略項目は変更しない)
    function applyCharState(t, st)
    {
        if (st.expr   !== void) setCharExpr(t, st.expr);
        if (st.motion !== void) playMotionForChar(t, st.motion);
        if (st.gaze   !== void) t.setLookAtCamera(st.gaze == "camera");
        // 位置(x=左右, z=前後)。空間モードでのみ意味を持つ。
        if (mode == "space" && (st.x !== void || st.z !== void)) {
            var nx = (st.x !== void) ? st.x : t.offX;
            var nz = (st.z !== void) ? st.z : t.offZ;
            t.spaceSet(nx, nz);
        }
        // 登場演出(dest レイヤのトゥイーン)。fadein/fadeout/slidein。
        if (st.fx !== void) applyCharFx(t, st.fx);
    }
    // キャラ単位の演出トリガ(シーン適用時)
    function applyCharFx(t, fx)
    {
        switch (fx) {
        case "fadein":  t.fadeIn(0.5);  break;
        case "fadeout": t.fadeOut(0.5); break;
        case "slidein":
            var dx = (t == tachies[0]) ? -240 : 240;   // 左は左から/右は右から
            t.slideIn(0.6, dx);
            break;
        }
    }
    // シーンのカメラ指定(mode/reset/frame/fov)。省略項目は変更しない。
    //   mode  … "tachie"/"space"(切替)
    //   reset … 1 でカメラを既定位置へ
    //   frame … 立ち絵モードの構図プリセット(full/knee/waist/bust/face)を全キャラへ
    //   fov   … 空間モードの画角
    function applySceneCamera(cam)
    {
        if (cam.mode  !== void && cam.mode != mode) setMode(cam.mode);
        if (cam.reset !== void && cam.reset) cameraReset();
        if (cam.frame !== void) { for (var i = 0; i < tachies.count; i++) tachies[i].frame(cam.frame); }
        if (cam.fov   !== void) setFov(cam.fov);
    }
    // シーン定義(chars: id->state / camera: 演出カメラ)を適用
    function applyScene(def)
    {
        var cs = def.chars;
        if (cs !== void) {
            var chars = stageDef.characters;
            for (var i = 0; i < chars.count && i < tachies.count; i++) {
                var st = cs[chars[i].id];
                if (st !== void) applyCharState(tachies[i], st);
            }
        }
        if (def.camera !== void) applySceneCamera(def.camera);
    }
    // 現在状態を dict へ(セーブ用)
    function captureState()
    {
        var chars = stageDef.characters;
        var cs = %[];
        for (var i = 0; i < chars.count && i < tachies.count; i++) {
            var t = tachies[i];
            cs[chars[i].id] = %[ "expr"   => (t.emotion  == "" ? "neutral" : t.emotion),
                                 "motion" => (t.motionId == "" ? "none"    : t.motionId),
                                 "gaze"   => (t.lookAtCamera ? "camera" : "off"),
                                 "x" => t.offX, "z" => t.offZ ];
        }
        return %[ "chars" => cs ];
    }
    function applyState(st) { if (st !== void) applyScene(st); }

    // セーブ: メモリ + ファイル(saveStruct があれば)。
    var stateFile = "stagestate.txt";
    function saveSlot()
    {
        savedState = captureState();
        try {
            (Dictionary.saveStruct incontextof savedState)(stateFile);
            Debug.message("stage state saved: " + stateFile);
        } catch (e) {
            Debug.message("file save skipped: " + e.message);   // saveStruct 無し等
        }
    }
    // ロード: ファイルがあればそれ、無ければメモリ。
    function loadSlot()
    {
        var st = void;
        try { if (Storages.isExistentStorage(stateFile)) st = Scripts.evalStorage(stateFile); } catch (e) { }
        if (st === void) st = savedState;
        applyState(st);
    }

    // --- 視線ターゲット ---------------------------------------------------
    function buildGazeLayer()
    {
        if (gazeLayer !== void) return;
        gazeLayer = new GazeLayer(this, back, this);
        gazeLayer.setImageSize(SCREEN_W, SCREEN_H);
        gazeLayer.setSize(SCREEN_W, SCREEN_H);
        gazeLayer.setPos(0, 0);
        gazeLayer.type = ltAlpha;
        gazeLayer.hitThreshold = 0;      // α>0 なら全面ヒット(ドラッグ捕捉用)
        gazeLayer.absolute = 100000;     // 最前面
        gazeLayer.visible = false;
        add(gazeLayer);
        drawGazeMarker();
    }
    function drawGazeMarker()
    {
        if (gazeLayer === void) return;
        gazeLayer.fillRect(0, 0, SCREEN_W, SCREEN_H, 0x01000000);  // α=1 全面(ヒット用・ほぼ不可視)
        var s = 20;
        var col = 0xFFFF3050, col2 = 0x90FF3050;
        gazeLayer.fillRect(gazeX - s, gazeY - 1, s * 2, 3, col);   // 横線
        gazeLayer.fillRect(gazeX - 1, gazeY - s, 3, s * 2, col);   // 縦線
        gazeLayer.fillRect(gazeX - s, gazeY - s, s * 2, 2, col2);  // 枠
        gazeLayer.fillRect(gazeX - s, gazeY + s, s * 2, 2, col2);
        gazeLayer.fillRect(gazeX - s, gazeY - s, 2, s * 2, col2);
        gazeLayer.fillRect(gazeX + s, gazeY - s, 2, s * 2, col2);
        gazeLayer.update();
    }
    function setGaze(x, y)
    {
        gazeX = x; gazeY = y;
        drawGazeMarker();
        applyGazeToChars();
    }
    // マーカーのスクリーン位置を各キャラの world 視線ターゲットへ変換
    function applyGazeToChars()
    {
        var nx = gazeX * 2.0 / SCREEN_W - 1.0;   // -1..1 (右+)
        var ny = gazeY * 2.0 / SCREEN_H - 1.0;   // -1..1 (下+)
        var spanX = 2.2, spanY = 1.5, depth = 2.5;
        for (var i = 0; i < tachies.count; i++) {
            var t = tachies[i];
            var scn = (mode == "space") ? spaceScene : t.scene;
            scn.updateMatrixWorld(true);
            var hp = t.vrm.getBoneNode("head").getWorldPosition();
            // ny 下+ なのでターゲットは下げる(マーカー下→ターゲット下→目も下)
            t.vrm.setLookAtTarget(hp.x + nx * spanX, hp.y - ny * spanY, hp.z + t.frontZ * depth);
        }
    }
    function toggleGaze(on)
    {
        gazeActive = on;
        buildGazeLayer();
        gazeLayer.visible = on;
        if (on) {
            // カメラ目線と競合するので一旦 OFF にしてターゲット駆動へ
            setAllLook(false);
            applyGazeToChars();
        } else {
            for (var i = 0; i < tachies.count; i++) tachies[i].vrm.clearLookAtTarget();
        }
    }

    // --- 操作対象の解決 -----------------------------------------------
    function targetList()
    {
        if (target == 0) return [tachies[0]];
        if (target == 1) return [tachies[1]];
        return tachies;
    }
    function applyFrame(p)
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].frame(p);
    }
    // 表情名 → 表情セット [name,w,…] に解決する。
    // "neutral"/"" = 空、合成表情id = その set、それ以外 = 単一 VRM 表情。
    var exprCompositeById;   // 合成表情 id -> name/set 定義
    function exprSetFor(name)
    {
        if (name == "neutral" || name == "" || name === void) return [];
        if (exprCompositeById !== void && exprCompositeById[name] !== void)
            return exprCompositeById[name].set;
        return [ name, 1.0 ];
    }
    function setCharExpr(t, name)
    {
        t.vrm.clearMorphs();   // 前の生モーフ指定を解除
        var def = (exprCompositeById !== void) ? exprCompositeById[name] : void;
        if (def !== void && def.morphs !== void) {
            // 生モーフ表情: 個別モーフ(ブレンドシェイプ)を名前で直接指定
            for (var i = 0; i < def.morphs.count; i += 2) t.vrm.setMorph(def.morphs[i], def.morphs[i + 1]);
            t.setEmotionSet(name, (def.set !== void) ? def.set : []);   // 併せて VRM 表情部分(あれば)
            return;
        }
        var id = (name == "neutral" || name === void) ? "" : name;
        t.setEmotionSet(id, exprSetFor(name));
    }
    function applyEmotion(name)
    {
        var list = targetList();
        for (var i = 0; i < list.count; i++) setCharExpr(list[i], name);
    }

    // ==================================================================
    //  表情編集(生モーフ簡易エディタ)
    // ==================================================================
    // 作業モード切替(ブラウザ編集UIのペインが追従。view の tachie/space とは直交)。
    function setWorkMode(m)
    {
        if (m == workMode) return;
        var prev = workMode;
        workMode = m;
        // 前モードの後始末
        if (prev == "face") { var l0 = targetList(); for (var i = 0; i < l0.count; i++) l0[i].vrm.clearMorphs(); }
        if (m == "face") {
            if (editMorphs === void) editMorphs = %[];
            if (faceLib === void) loadFaceLib();
            // 編集は顔がよく見えるよう対象を顔フレーミング + 目線/idle を止める
            var list = targetList();
            for (var i = 0; i < list.count; i++) {
                list[i].setLookAtCamera(false);
                list[i].setIdleEnabled(false);
            }
            applyFrame("face");
            applyEditToTargets();
        } else if (m == "pose") {
            if (poseLib === void) loadPoseLib();
            // ポーズは全身が見えるよう膝上〜全身へ + idle を止める(編集が上書きされないよう)
            var list = targetList();
            for (var i = 0; i < list.count; i++) list[i].setIdleEnabled(false);
            applyFrame("knee");
            if (editPose === void) captureEditPose();   // 初回は現在姿勢を採取(リビルドは末尾で一度)
            else applyEditPoseLive();
        } else if (m == "seq") {
            if (poseLib === void) loadPoseLib();
            // 全身が見えるよう + idle を止める(プレビュー再生が上書きされないよう)
            var list = targetList();
            for (var i = 0; i < list.count; i++) list[i].setIdleEnabled(false);
            applyFrame("knee");
        } else if (m == "char") {
            // キャラ管理: 未選択なら左スロットのキャラを選択状態に
            if (charSel == "" && charReg !== void) charSel = charReg.slots[0];
        }
    }
    // 編集中の生モーフを対象キャラへライブ反映(0 のものは送らない)
    function applyEditToTargets()
    {
        var pairs = dictPairs(editMorphs);
        var list = targetList();
        for (var i = 0; i < list.count; i++) {
            var t = list[i];
            t.vrm.clearMorphs();
            t.setEmotionSet("", []);   // VRM 表情も素に(生モーフだけで作る)
            for (var j = 0; j < pairs.count; j += 2)
                if (pairs[j + 1] > 0.0) t.vrm.setMorph(pairs[j], pairs[j + 1]);
        }
    }
    // スライダ操作: 1 モーフの weight を更新してライブ反映
    function editSetMorph(name, w)
    {
        if (editMorphs === void) editMorphs = %[];
        editMorphs[name] = w;
        applyEditToTargets();
    }
    function editGetMorph(name)
    {
        if (editMorphs === void || editMorphs[name] === void) return 0.0;
        return editMorphs[name];
    }
    // すべてのスライダを 0 に(素立ちの顔へ)。パネルを組み直してスライダも戻す。
    function editClear()
    {
        editMorphs = %[];
        applyEditToTargets();
    }
    // --- 表情ライブラリ(共有 JSON: faces.json)---
    // 形式: %[ "version"=>1, "faces"=>%[ id=>%[ "label"=>表示名, "morphs"=>%[Fcl名=>w] ] ] ]
    function loadFaceLib()
    {
        faceLib = %[];
        try {
            // 読込は autopath 解決される既存ファイルパスで(getPlacedPath は存在時のみ有効)。
            if (Storages.isExistentStorage(FACE_LIB_FILE)) {
                var root = Scripts.evalJSONStorage(Storages.getPlacedPath(FACE_LIB_FILE), 1);
                if (root !== void && root.faces !== void) faceLib = root.faces;
            }
        } catch (e) { Debug.message("faces.json 読込失敗: " + e.message); }
    }
    function saveFaceLib()
    {
        try {
            var root = %[ "version" => 1, "faces" => faceLib ];
            // 書込は bare 名で(getPlacedPath は未存在ファイルに空を返すため使えない)。
            // saveStruct の *.txt と同じく data/ 直下に書かれる。utf8=true, indent=1(整形)。
            Scripts.saveJSON(FACE_LIB_FILE, root, 1, 1);
            Debug.message("faces.json 保存: " + faceLib.count + " 表情");
        } catch (e) { Debug.message("faces.json 保存失敗: " + e.message); }
    }
    // 編集中の内容を editName のキーワードで保存(0 のモーフは省く)
    function saveCurrentFace()
    {
        if (editName == "" || editName === void) { Debug.message("表情名を入力してください"); return; }
        if (faceLib === void) loadFaceLib();
        var morphs = %[];
        var pairs = dictPairs(editMorphs);
        for (var j = 0; j < pairs.count; j += 2) if (pairs[j + 1] > 0.0) morphs[pairs[j]] = pairs[j + 1];
        faceLib[editName] = %[ "label" => editName, "morphs" => morphs ];
        saveFaceLib();
    }
    // ライブラリの表情を編集スロットへ読み込む(スライダに反映するためパネル再構築)
    function loadFaceIntoEdit(id)
    {
        if (faceLib === void) loadFaceLib();
        var def = faceLib[id];
        if (def === void) return;
        editName = id;
        editMorphs = %[];
        var pairs = dictPairs(def.morphs);
        for (var j = 0; j < pairs.count; j += 2) editMorphs[pairs[j]] = pairs[j + 1];
        applyEditToTargets();
    }
    function faceIdList()
    {
        if (faceLib === void) loadFaceLib();
        var pairs = dictPairs(faceLib);
        var ids = [];
        for (var j = 0; j < pairs.count; j += 2) ids.add(pairs[j]);
        return ids;
    }

    // ==================================================================
    //  ポーズ編集(簡易エディタ)
    // ==================================================================
    // editPose(%[ボーン名=>[qx,qy,qz,qw]])を対象キャラへライブ適用。
    function applyEditPoseLive()
    {
        if (editPose === void) return;
        var arr = [];   // applyPose 用フラット配列 [名,qx,qy,qz,qw,…]
        var pairs = dictPairs(editPose);
        for (var j = 0; j < pairs.count; j += 2) {
            var q = pairs[j + 1];
            arr.add(pairs[j]); arr.add(q[0]); arr.add(q[1]); arr.add(q[2]); arr.add(q[3]);
        }
        var hips = [ editHips[0], editHips[1], editHips[2] ];
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].setPoseLive(arr, hips);
    }
    // 現在の対象姿勢を編集スロットへ採取([名,qx,…] → %[名=>[qx,…]])。リビルドしない。
    function captureEditPose()
    {
        var list = targetList();
        if (list.count == 0) return;
        var flat = list[0].capturePose();
        editPose = %[];
        for (var j = 0; j < flat.count; j += 5)
            editPose[flat[j]] = [ flat[j + 1], flat[j + 2], flat[j + 3], flat[j + 4] ];
        var ho = list[0].vrm.getHipsOffset();
        editHips = [ ho.x, ho.y, ho.z ];
        applyEditPoseLive();
    }
    function poseBaseCapture()
    {
        captureEditPose();
    }
    // 素立ち(モデルの自然な A-pose)を基準にする。
    // identity 正規化は正準 T-pose なので、Tachie.restPose() で腕を下ろした A-pose を作って採取する。
    function poseBaseRest()
    {
        var list = targetList();
        if (list.count == 0) return;
        var t = list[0];
        t.vrm.resetNormalizedPose();   // 正規化を identity(T-pose)へ
        t.restPose();                  // 腕を体側へ下ろして自然な A-pose に
        editPose = %[];
        var flat = t.capturePose();    // ★Tachie のメソッド(vrm ではない)
        for (var j = 0; j < flat.count; j += 5)
            editPose[flat[j]] = [ flat[j + 1], flat[j + 2], flat[j + 3], flat[j + 4] ];
        editHips = [ 0.0, 0.0, 0.0 ];
        applyEditPoseLive();
    }
    // hips ルートモーション オフセット 1 軸(0=x/1=y/2=z)をメートル値で設定しライブ反映
    function editSetHips(axis, meter)
    {
        editHips[axis] = meter;
        applyEditPoseLive();
    }
    // 回転スライダ用: 選択ボーンの現在オイラー角(度)[rx,ry,rz]
    function editBoneEuler()
    {
        if (editPose === void || editPose[editBone] === void) return [ 0.0, 0.0, 0.0 ];
        var q = editPose[editBone];
        return quatToEuler(q[0], q[1], q[2], q[3]);
    }
    // 選択ボーンを切替(スライダを更新するためパネル再構築)
    function editSelectBone(name)
    {
        editBone = name;
    }
    // 選択ボーンの 1 軸(0=x/1=y/2=z)の角度を deg にしてライブ反映
    function editSetBoneRot(axis, deg)
    {
        if (editPose === void) return;
        var e = editBoneEuler();
        e[axis] = deg;
        editPose[editBone] = eulerToQuat(e[0], e[1], e[2]);
        applyEditPoseLive();
    }
    // --- ポーズライブラリ(共有 JSON: poses.json)---
    // 形式: %[ "version"=>1, "poses"=>%[ id=>%[ "label"=>名, "bones"=>%[ボーン名=>[qx,qy,qz,qw]] ] ] ]
    function loadPoseLib()
    {
        poseLib = %[];
        try {
            if (Storages.isExistentStorage(POSE_LIB_FILE)) {
                var root = Scripts.evalJSONStorage(Storages.getPlacedPath(POSE_LIB_FILE), 1);
                if (root !== void && root.poses !== void) poseLib = root.poses;
            }
        } catch (e) { Debug.message("poses.json 読込失敗: " + e.message); }
    }
    function savePoseLib()
    {
        try {
            var root = %[ "version" => 1, "poses" => poseLib ];
            Scripts.saveJSON(POSE_LIB_FILE, root, 1, 1);   // bare 名 / utf8 / indent
            Debug.message("poses.json 保存: " + poseLib.count + " ポーズ");
        } catch (e) { Debug.message("poses.json 保存失敗: " + e.message); }
    }
    function saveCurrentPose()
    {
        if (poseName == "" || poseName === void) { Debug.message("ポーズ名を入力してください"); return; }
        if (poseLib === void) loadPoseLib();
        if (editPose === void) return;
        // bones をコピー(参照共有を避ける)
        var bones = %[];
        var pairs = dictPairs(editPose);
        for (var j = 0; j < pairs.count; j += 2) { var q = pairs[j + 1]; bones[pairs[j]] = [ q[0], q[1], q[2], q[3] ]; }
        poseLib[poseName] = %[ "label" => poseName, "bones" => bones,
                               "hips" => [ editHips[0], editHips[1], editHips[2] ] ];
        savePoseLib();
    }
    function loadPoseIntoEdit(id)
    {
        if (poseLib === void) loadPoseLib();
        var def = poseLib[id];
        if (def === void) return;
        poseName = id;
        editPose = %[];
        var pairs = dictPairs(def.bones);
        for (var j = 0; j < pairs.count; j += 2) { var q = pairs[j + 1]; editPose[pairs[j]] = [ q[0], q[1], q[2], q[3] ]; }
        editHips = (def.hips !== void) ? [ def.hips[0], def.hips[1], def.hips[2] ] : [ 0.0, 0.0, 0.0 ];
        applyEditPoseLive();
    }
    function poseIdList()
    {
        if (poseLib === void) loadPoseLib();
        var pairs = dictPairs(poseLib);
        var ids = [];
        for (var j = 0; j < pairs.count; j += 2) ids.add(pairs[j]);
        return ids;
    }
    // ポーズの hips オフセット [dx,dy,dz](無ければ [0,0,0])
    function poseHipsFromLib(id)
    {
        if (poseLib === void) loadPoseLib();
        var def = poseLib[id];
        if (def !== void && def.hips !== void) return [ def.hips[0], def.hips[1], def.hips[2] ];
        return [ 0.0, 0.0, 0.0 ];
    }
    // 保存済みポーズ列(poses.json の id 群)を VRMA モーションへ書き出す。
    // poseIds をキー時刻 i*step 秒に並べ、glTF LINEAR 補間で遷移する poseseq を焼き込む。
    // hips オフセットがあれば translation チャンネル(ルートモーション)も書く。
    // 出力は共有 glTF-JSON 形式の .vrma(自前ローダ/three-vrm で読める)。成功で true。
    function exportPoseSeqVRMA(poseIds, step, outFile)
    {
        if (poseLib === void) loadPoseLib();
        if (poseIds === void || poseIds.count == 0) return false;
        // 全ポーズに現れるボーンの和集合(順序保持)を列に
        var boneOrder = []; var seen = %[];
        for (var i = 0; i < poseIds.count; i++) {
            var def = poseLib[poseIds[i]]; if (def === void) continue;
            var pr = dictPairs(def.bones);
            for (var j = 0; j < pr.count; j += 2) if (seen[pr[j]] === void) { seen[pr[j]] = 1; boneOrder.add(pr[j]); }
        }
        var nB = boneOrder.count;
        if (nB == 0) return false;
        // 各キー(=ポーズ)の時刻 + quat 平坦列((key,bone,xyzw) 行優先) + hips 平坦列((key,xyz))
        var times = []; var quats = []; var hips = []; var anyHips = false;
        for (var i = 0; i < poseIds.count; i++) {
            var def = poseLib[poseIds[i]];
            times.add(i * step);
            var m = %[];
            if (def !== void) { var pr = dictPairs(def.bones); for (var j = 0; j < pr.count; j += 2) m[pr[j]] = pr[j + 1]; }
            for (var b = 0; b < nB; b++) {
                var q = m[boneOrder[b]];
                if (q === void) q = [ 0.0, 0.0, 0.0, 1.0 ];
                quats.add(q[0]); quats.add(q[1]); quats.add(q[2]); quats.add(q[3]);
            }
            var h = poseHipsFromLib(poseIds[i]);
            if (h[0] != 0.0 || h[1] != 0.0 || h[2] != 0.0) anyHips = true;
            hips.add(h[0]); hips.add(h[1]); hips.add(h[2]);
        }
        var ld = new Threepp.VRMAnimationLoader();
        var ok = ld.exportPoseSeq(boneOrder, times, quats, (anyHips ? hips : []), [], [], outFile);
        Debug.message("VRMA 書出 " + (ok ? "成功" : "失敗") + ": " + outFile + " (" + poseIds.count + "キー/" + nB + "ボーン"
                      + (anyHips ? "/hips有" : "") + ")");
        return ok;
    }

    // ==================================================================
    //  シーケンス編集(時間軸: ポーズ列 + 各手順の hold/trans → プレビュー / VRMA)
    // ==================================================================
    // seq = [ %[pose=>id, hold=>保持秒, trans=>遷移秒] ]。seqSel = 選択中の手順 index。
    var seq;
    var seqSel = -1;
    function seqEnsure() { if (seq === void) seq = []; }
    // poseLib[id].bones(%[bone=>[qx,qy,qz,qw]])→ [name,qx,qy,qz,qw,…] フラット
    function poseFlatFromLib(id)
    {
        if (poseLib === void) loadPoseLib();
        var def = poseLib[id];
        if (def === void || def.bones === void) return void;
        var arr = []; var pr = dictPairs(def.bones);
        for (var j = 0; j < pr.count; j += 2) {
            var q = pr[j + 1];
            arr.add(pr[j]); arr.add(q[0]); arr.add(q[1]); arr.add(q[2]); arr.add(q[3]);
        }
        return arr;
    }
    function seqRebuildPanel() {}   // Elements パネル撤去済 (ブラウザ UI は SSE push で同期)
    function seqAddPose(id)
    {
        seqEnsure();
        seq.add(%[ "pose" => id, "hold" => 0.8, "trans" => 0.4, "expr" => "" ]);
        seqSel = seq.count - 1;
        seqRebuildPanel();
    }
    // 選択手順の表情(VRM 表情名。""=無し)を設定。パネル再構築で選択反映。
    function seqSetExpr(name)
    {
        if (seq === void || seqSel < 0 || seqSel >= seq.count) return;
        seq[seqSel].expr = (name == "none") ? "" : name;
        seqRebuildPanel();
    }
    function seqSelectStep(i) { seqSel = i; seqRebuildPanel(); }
    function seqDelStep()
    {
        if (seq === void || seqSel < 0 || seqSel >= seq.count) return;
        seq.erase(seqSel);
        if (seqSel >= seq.count) seqSel = seq.count - 1;
        seqRebuildPanel();
    }
    function seqMoveStep(dir)
    {
        if (seq === void || seqSel < 0) return;
        var ni = seqSel + dir;
        if (ni < 0 || ni >= seq.count) return;
        var tmp = seq[seqSel]; seq[seqSel] = seq[ni]; seq[ni] = tmp;
        seqSel = ni;
        seqRebuildPanel();
    }
    function seqClear() { seq = []; seqSel = -1; seqStop(); seqRebuildPanel(); }
    // 選択手順の hold/trans をスライダから更新(ライブ、リビルドしない)
    function seqSetHold(sec)  { if (seq !== void && seqSel >= 0 && seqSel < seq.count) seq[seqSel].hold  = sec; }
    function seqSetTrans(sec) { if (seq !== void && seqSel >= 0 && seqSel < seq.count) seq[seqSel].trans = sec; }
    // プレビュー: playPoseSeq 用の keys に変換して対象で再生(ループ)
    function seqPreview()
    {
        seqEnsure();
        if (seq.count == 0) return;
        var keys = [];
        for (var i = 0; i < seq.count; i++) {
            var s = seq[i];
            var d = poseFlatFromLib(s.pose);
            var k = %[ "in" => s.trans, "hold" => s.hold, "hips" => poseHipsFromLib(s.pose),
                       "expr" => (s.expr !== void ? s.expr : "") ];
            if (d === void) k["isRest"] = 1; else k["data"] = d;
            keys.add(k);
        }
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].playPoseSeq(keys, 1);
    }
    function seqStop() { var list = targetList(); for (var i = 0; i < list.count; i++) list[i].stopMotion(); }
    // 1 キー分(時刻 t + boneOrder 順の quat)を times/quats へ追記
    function seqAppendKey(times, quats, t, m, boneOrder)
    {
        times.add(t);
        for (var b = 0; b < boneOrder.count; b++) {
            var q = m[boneOrder[b]];
            if (q === void) q = [ 0.0, 0.0, 0.0, 1.0 ];
            quats.add(q[0]); quats.add(q[1]); quats.add(q[2]); quats.add(q[3]);
        }
    }
    // シーケンスを hold/trans のタイミングで VRMA へ焼き込む。
    // 各手順は「(前手順から trans 秒で遷移)→ そのポーズを hold 秒保持」= 2 キー(保持始/保持終)で表現。
    function seqExportVRMA(outFile)
    {
        seqEnsure();
        if (seq.count == 0) { Debug.message("シーケンスが空です"); return false; }
        if (poseLib === void) loadPoseLib();
        // ボーンの和集合 + 各手順の name->quat マップ
        var boneOrder = []; var seen = %[]; var maps = [];
        for (var i = 0; i < seq.count; i++) {
            var def = poseLib[seq[i].pose];
            var m = %[];
            if (def !== void && def.bones !== void) {
                var pr = dictPairs(def.bones);
                for (var j = 0; j < pr.count; j += 2) {
                    m[pr[j]] = pr[j + 1];
                    if (seen[pr[j]] === void) { seen[pr[j]] = 1; boneOrder.add(pr[j]); }
                }
            }
            maps.add(m);
        }
        if (boneOrder.count == 0) return false;
        // キーフレーム(保持始/保持終の2枚ずつ。手順間の隙間=遷移として LINEAR 補間される)
        // hips オフセットも同じ2枚ずつ並べる(ルートモーション)。
        var times = []; var quats = []; var hips = []; var anyHips = false; var cursor = 0.0;
        for (var i = 0; i < seq.count; i++) {
            var h = poseHipsFromLib(seq[i].pose);
            if (h[0] != 0.0 || h[1] != 0.0 || h[2] != 0.0) anyHips = true;
            if (i > 0) cursor += seq[i].trans;   // 先頭以外は前手順から遷移
            seqAppendKey(times, quats, cursor, maps[i], boneOrder);
            hips.add(h[0]); hips.add(h[1]); hips.add(h[2]);
            cursor += seq[i].hold;
            seqAppendKey(times, quats, cursor, maps[i], boneOrder);
            hips.add(h[0]); hips.add(h[1]); hips.add(h[2]);
        }
        // 表情トラック: 使われている表情名の和集合。各表情の weight は、その手順の2キー(保持始/終)で
        // 1、他は 0(LINEAR 補間で遷移中フェード)。keyframe kf の手順 = kf/2。
        var exprNames = []; var exprSeen = %[];
        for (var i = 0; i < seq.count; i++) {
            var ex = seq[i].expr;
            if (ex !== void && ex != "" && exprSeen[ex] === void) { exprSeen[ex] = 1; exprNames.add(ex); }
        }
        var nKf = times.count;
        var exprW = [];   // expr-major 平坦: [e0: kf0..kfN, e1: …]
        for (var e = 0; e < exprNames.count; e++) {
            for (var kf = 0; kf < nKf; kf++) {
                var st = (int)(kf / 2);
                exprW.add((st < seq.count && seq[st].expr == exprNames[e]) ? 1.0 : 0.0);
            }
        }
        var ld = new Threepp.VRMAnimationLoader();
        var ok = ld.exportPoseSeq(boneOrder, times, quats, (anyHips ? hips : []), exprNames, exprW, outFile);
        Debug.message("シーケンス書出 " + (ok ? "成功" : "失敗") + ": " + outFile
                      + " (" + seq.count + "手順/" + times.count + "キー/" + boneOrder.count + "ボーン"
                      + (anyHips ? "/hips有" : "") + (exprNames.count > 0 ? ("/表情" + exprNames.count) : "")
                      + ", " + cursor + "秒)");
        return ok;
    }

    // --- 表情名の列挙(モデル実装から) ---
    var emoNameSet;   // 表情ボタン id 判定用
    var exprLabels = %[ "happy"=>"喜", "angry"=>"怒", "sad"=>"哀", "relaxed"=>"楽",
                        "surprised"=>"驚", "neutral"=>"標準",
                        "joy"=>"喜", "sorrow"=>"哀", "fun"=>"楽" ];
    function exprLabel(name) { var l = exprLabels[name]; return (l === void) ? name : l; }
    // 感情系の表情名一覧(ビセーム/まばたき/視線/neutral は除外)。既知の感情を
    // 好ましい順(喜怒哀楽驚)で先頭に、カスタム表情を末尾に。emoNameSet も更新。
    function emotionNames()
    {
        var vrm = tachies[0].vrm;
        var n = vrm.getExpressionCount();
        var have = %[];
        for (var i = 0; i < n; i++) { var nm = vrm.getExpressionName(i); if (nm != "") have[nm] = 1; }

        var skip = %[ "aa"=>1, "ih"=>1, "ou"=>1, "ee"=>1, "oh"=>1,
                      "blink"=>1, "blinkLeft"=>1, "blinkRight"=>1, "blink_l"=>1, "blink_r"=>1,
                      "lookUp"=>1, "lookDown"=>1, "lookLeft"=>1, "lookRight"=>1, "neutral"=>1 ];
        var pref = ["happy", "angry", "sad", "relaxed", "surprised", "joy", "sorrow", "fun"];

        var list = [];
        emoNameSet = %[ "neutral"=>1 ];
        // 既知の感情を好ましい順で
        for (var i = 0; i < pref.count; i++) {
            var nm = pref[i];
            if (have[nm] !== void && skip[nm] === void && emoNameSet[nm] === void) {
                list.add(nm); emoNameSet[nm] = 1;
            }
        }
        // 残りの非スキップ表情(カスタム)を末尾に
        for (var i = 0; i < n; i++) {
            var nm = vrm.getExpressionName(i);
            if (nm == "" || skip[nm] !== void || emoNameSet[nm] !== void) continue;
            list.add(nm); emoNameSet[nm] = 1;
        }
        // 合成表情 id もパネル判定用に登録
        var ex = stageDef.expressions;
        if (ex !== void) for (var i = 0; i < ex.count; i++) emoNameSet[ex[i].id] = 1;
        return list;
    }
    // ON/OFF トグルは全キャラ共通(toggle_button の値をそのまま適用)
    function setAllBlink(on)
    {
        for (var i = 0; i < tachies.count; i++) tachies[i].setBlinkEnabled(on);
    }
    function setAllLook(on)
    {
        for (var i = 0; i < tachies.count; i++) tachies[i].setLookAtCamera(on);
    }
    function setAllIdle(on)
    {
        for (var i = 0; i < tachies.count; i++) tachies[i].setIdleEnabled(on);
    }
    function cameraOrbit(dyaw, dpitch)
    {
        if (mode == "space") {
            if (sCamMode == "move") {
                // 平行移動: dyaw→左右(truck) / dpitch→上下(pedestal)。注視点を動かすと
                // カメラ位置も一緒に動く(視線方向は不変=平行移動)。
                var hs = dyaw * 1.3;
                sTX += hs * Math.cos(sCamYaw);
                sTZ += -hs * Math.sin(sCamYaw);
                sTY += dpitch * 1.3;
            } else {
                sCamYaw += dyaw; sCamPitch += dpitch;
                if (sCamPitch >  1.2) sCamPitch =  1.2;
                if (sCamPitch < -1.2) sCamPitch = -1.2;
            }
            updateSpaceCamera();
            return;
        }
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].orbit(dyaw, dpitch);
    }
    function cameraDolly(factor)
    {
        if (mode == "space") {
            if (sCamMode == "move") {
                // 前後平行移動: factor<1(寄る)=前へ / >1(引く)=後ろへ
                var step = (factor < 1.0) ? 0.3 : -0.3;
                sTX += step * (-Math.sin(sCamYaw));
                sTZ += step * (-Math.cos(sCamYaw));
            } else {
                sCamDist *= factor;
                if (sCamDist < 1.0)  sCamDist = 1.0;
                if (sCamDist > 12.0) sCamDist = 12.0;
            }
            updateSpaceCamera();
            return;
        }
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].dolly(factor);
    }
    function cameraReset()
    {
        if (mode == "space") {
            sCamYaw = 0.0; sCamPitch = 0.02; sCamDist = 3.8;
            sTX = 0.0; sTY = 1.0; sTZ = 0.0;
            updateSpaceCamera();
            return;
        }
        var list = targetList();
        for (var i = 0; i < list.count; i++) list[i].resetCamera();
    }

    // ==================================================================
    //  キャラ管理(レジストリ: chars/registry.json + chars/<id>/char.json)
    // ==================================================================
    function selectChar(id)
    {
        charSel = id;
    }
    // レジストリのキャラをスロット(0=左, 1=右)へ割り当てる(VRM を差し替える)。
    function assignSlot(slot, id)
    {
        if (id == "" || id === void) { Debug.message("キャラを選択してください"); return; }
        if (charReg.slots[slot] == id) return;   // 変更なし
        var def = charReg.loadCharDef(id);
        if (def === void) { Debug.message("char.json が読めません: " + id); return; }
        var t = tachies[slot];
        var ox = t.offX, oz = t.offZ;
        t.unload();
        if (!t.load(def.vrm, def.frontZ, (slot == 0) ? LEFT_X : RIGHT_X, 0)) {
            slotDefs[slot] = void;
            return;
        }
        if (mode == "space") {
            // 空間モード中: 新しい VRM シーンを空間へ移設し、配置を引き継ぐ
            spaceScene.add(t.vrm.getScene());
            t.spaceSet(ox, oz);
            t.dest.visible = false;
        } else if (def.defaultFrame !== void) {
            t.frame(def.defaultFrame);   // 既定フレーミング(char.json)
        }
        if (def.defaultExpr !== void && def.defaultExpr != "neutral" && def.defaultExpr != "")
            setCharExpr(t, def.defaultExpr);   // 既定表情(char.json)
        slotDefs[slot] = def;
        charReg.slots[slot] = id;
        charReg.save();
    }
    // 新規登録フォームの内容でフォルダ+char.json を作りレジストリへ追加する。
    function registerCharAction()
    {
        var id = charReg.register(regId, regName, regVrm, regFrontZ);
        if (id == "") { Debug.message("登録失敗: id と VRM ファイル名を確認してください"); return; }
        charSel = id;
    }
    // スロットに割当中のキャラ表示名(インスペクタ用)
    function slotName(i)
    {
        if (slotDefs !== void && slotDefs[i] !== void) return slotDefs[i].name;
        return (i == 0) ? "左" : "右";
    }

    // Elements パネルからの操作。val は toggle_button の bool 値 / slider の 0..1 /
    // input_box の文字列(それ以外は void)。
    function onPanel(id, val)
    {
        // スライダ(連続発火)はログに出さず先に処理
        if (id.length >= 3 && id.substring(0, 3) == "mo:") { editSetMorph(id.substring(3), val + 0.0); return; }
        if (id.length >= 4 && id.substring(0, 4) == "rot:") {   // ポーズ回転(0..1 → -180..180 度)
            var deg = (val + 0.0) * 360.0 - 180.0;
            var ax = id.substring(4);
            editSetBoneRot((ax == "x") ? 0 : ((ax == "y") ? 1 : 2), deg);
            return;
        }
        if (id.length >= 3 && id.substring(0, 3) == "hp:") {    // hips 移動(0..1 → -0.5..0.5 m)
            var m = (val + 0.0) * 1.0 - 0.5;
            var ax2 = id.substring(3);
            editSetHips((ax2 == "x") ? 0 : ((ax2 == "y") ? 1 : 2), m);
            return;
        }
        if (id == "sh") { seqSetHold((val + 0.0) * 3.0);  return; }   // シーケンス保持秒スライダ
        if (id == "st") { seqSetTrans((val + 0.0) * 3.0); return; }   // シーケンス遷移秒スライダ
        logLine(id);   // 情報欄の操作ログへ
        // --- 作業モード切替 ---
        if (id == "work_op")   { setWorkMode("op");   return; }
        if (id == "work_face") { setWorkMode("face"); return; }
        if (id == "work_pose") { setWorkMode("pose"); return; }
        if (id == "work_seq")  { setWorkMode("seq");  return; }
        if (id == "work_char") { setWorkMode("char"); return; }
        // --- キャラ管理(レジストリ) ---
        if (id.length >= 3 && id.substring(0, 3) == "cs:") { selectChar(id.substring(3)); return; }
        if (id == "char_asn_l") { assignSlot(0, charSel); return; }
        if (id == "char_asn_r") { assignSlot(1, charSel); return; }
        if (id == "reg_id")   { regId   = (val === void) ? "" : "" + val; return; }
        if (id == "reg_name") { regName = (val === void) ? "" : "" + val; return; }
        if (id == "reg_vrm")  { regVrm  = (val === void) ? "" : "" + val; return; }
        if (id == "reg_fz_p") { regFrontZ =  1; return; }
        if (id == "reg_fz_n") { regFrontZ = -1; return; }
        if (id == "char_reg") { registerCharAction(); return; }
        // --- シーケンス(時間軸)編集 ---
        if (id == "seq_preview") { seqPreview();  return; }
        if (id == "seq_stop")    { seqStop();     return; }
        if (id == "seq_clear")   { seqClear();    return; }
        if (id == "seq_del")     { seqDelStep();  return; }
        if (id == "seq_up")      { seqMoveStep(-1); return; }
        if (id == "seq_down")    { seqMoveStep(1);  return; }
        if (id == "seq_export")  { seqExportVRMA("poseseq.vrma"); return; }
        if (id.length >= 3 && id.substring(0, 3) == "ss:") { seqSelectStep((int)id.substring(3)); return; }
        if (id.length >= 3 && id.substring(0, 3) == "sq:") { seqAddPose(id.substring(3)); return; }
        if (id.length >= 3 && id.substring(0, 3) == "se:") { seqSetExpr(id.substring(3)); return; }
        // --- 表情編集 ---
        if (id == "face_name")  { editName = (val === void) ? "" : "" + val; return; }
        if (id == "face_save")  { saveCurrentFace(); return; }
        if (id == "face_clear") { editClear(); return; }
        if (id.length >= 3 && id.substring(0, 3) == "lf:") { loadFaceIntoEdit(id.substring(3)); return; }
        // --- ポーズ編集 ---
        if (id == "pose_base_cap")  { poseBaseCapture(); return; }
        if (id == "pose_base_rest") { poseBaseRest();    return; }
        if (id == "pose_name")      { poseName = (val === void) ? "" : "" + val; return; }
        if (id == "pose_save2")     { saveCurrentPose(); return; }
        if (id == "pose_export")    { exportPoseSeqVRMA(poseIdList(), 1.0, "poseseq.vrma"); return; }
        if (id.length >= 3 && id.substring(0, 3) == "pb:") { editSelectBone(id.substring(3)); return; }
        if (id.length >= 3 && id.substring(0, 3) == "lp:") { loadPoseIntoEdit(id.substring(3)); return; }
        // 表情ボタン(id=表情名)は動的なので switch より先に判定
        if (emoNameSet !== void && emoNameSet[id] !== void) { applyEmotion(id); return; }
        // モーションボタン(id=m_*)
        if (motionBtnMap !== void && motionBtnMap[id] !== void) { playMotionOnTargets(motionBtnMap[id]); return; }
        if (id == "m_stop") { stopMotionOnTargets(); return; }
        // シーンボタン(id=sc_*) / 状態のセーブ・復元
        if (sceneBtnMap !== void && sceneBtnMap[id] !== void) { applyScene(sceneBtnMap[id]); return; }
        if (id == "state_save") { saveSlot(); return; }
        if (id == "state_load") { loadSlot(); return; }
        // 立ち絵演出
        if (id == "fx_fadein")  { fxFadeIn();  return; }
        if (id == "fx_fadeout") { fxFadeOut(); return; }
        if (id == "fx_slidein") { fxSlideIn(); return; }
        // リップシンク(発話音声で口を駆動)
        if (id == "lip_play")   { lipPlay();  return; }
        if (id == "lip_stop")   { lipStop();  return; }
        // ポーズ
        if (id == "pose_cap")   { capturePoseAction(); return; }
        if (id == "pose_apply") { applyPoseSlot("cap"); return; }
        if (id == "pose_clear") { clearPoseAction(); return; }
        if (id == "pose_save")  { savePoseAction(); return; }
        if (id == "pose_load")  { loadPoseAction(); return; }

        switch (id) {
        case "t_left":  target = 0; break;
        case "t_right": target = 1; break;
        case "t_both":  target = 2; break;

        case "f_full":  applyFrame("full");  break;
        case "f_knee":  applyFrame("knee");  break;
        case "f_waist": applyFrame("waist"); break;
        case "f_bust":  applyFrame("bust");  break;
        case "f_face":  applyFrame("face");  break;

        case "cam_left":  cameraOrbit(-0.18, 0.0); break;
        case "cam_right": cameraOrbit( 0.18, 0.0); break;
        case "cam_up":    cameraOrbit( 0.0,  0.12); break;
        case "cam_down":  cameraOrbit( 0.0, -0.12); break;
        case "cam_in":    cameraDolly(1.0 / 1.1); break;
        case "cam_out":   cameraDolly(1.1); break;
        case "cam_reset": cameraReset(); break;

        case "pos_left":  moveChar(-0.15, 0.0); break;
        case "pos_right": moveChar( 0.15, 0.0); break;
        case "pos_fwd":   moveChar( 0.0,  0.2); break;   // 前=カメラ側(+z)
        case "pos_back":  moveChar( 0.0, -0.2); break;
        case "pos_reset": resetCharPos(); break;

        case "fov_tele":  setFov(sFov - 4); break;       // 望遠(平行寄り)
        case "fov_wide":  setFov(sFov + 4); break;       // 広角

        case "camm_orbit": sCamMode = "orbit"; break;    // 回り込み
        case "camm_move":  sCamMode = "move";  break;    // 平行移動
        case "bg_fixed":   bgFollow = false; break;      // 背景=舞台奥に固定
        case "bg_follow":  bgFollow = true;  break;      // 背景=カメラ追従

        case "blink_set": setAllBlink(val); break;
        case "look_set":  setAllLook(val);  break;
        case "idle_set":  setAllIdle(val);  break;
        case "gaze_set":  toggleGaze(val);  break;

        case "mode_tachie":  setMode("tachie"); break;
        case "mode_space":   setMode("space");  break;

        }
    }

    function onFrame()
    {
        var now = System.getTickCount();
        var dt  = (now - lastTick) / 1000.0;
        lastTick = now;
        if (dt > 0.1) dt = 0.1;

        // rig/表情/まばたき/揺れ物は両モードとも更新
        for (var i = 0; i < tachies.count; i++) tachies[i].update(dt);

        if (mode == "space") {
            updateSpaceBg();
            adaptor.capture(spaceDest, global.spaceRenderCb, this, 0x00000000);
            spaceDest.update();
        } else {
            for (var i = 0; i < tachies.count; i++) tachies[i].render();
        }

        // 情報パネルを ~4Hz で更新
        infoClock += dt;
        if (infoClock >= 0.25) {
            var fps = (dt > 0.0) ? (1.0 / dt) : 60.0;
            drawInspector();
            drawLog(fps);
            infoClock = 0.0;
        }
    }

    // 対象判定(target: 0=左 1=右 2=両方)。i 番のキャラが選択対象か。
    function isSelected(i)
    {
        return (target == 2) || (target == i);
    }

    // 右: インスペクター(選択対象の状態を縦に表示)。選択キャラを強調。
    function drawInspector()
    {
        if (inspLayer === void) return;
        var L = inspLayer;
        L.fillRect(0, 0, INSP_W, INSP_H, 0xFF14171F);
        L.fillRect(0, 0, 2, INSP_H, 0x40FFFFFF);   // 左境界
        try { L.font.face = "ＭＳ ゴシック"; } catch (e) { }
        // ★drawText の色は 24bit(0xRRGGBB)。32bit(0xFFRRGGBB)を渡すと暗く化ける。
        var white = 0xF4F6FA, dim = 0xC2CCDA, key = 0x9AD8FF, sel = 0x88ECAE, off = 0x98A2B0;
        var x = 16, y = 18;
        L.font.height = 20;
        L.drawText(x, y, "インスペクター", key, 255, true); y += 34;
        L.font.height = 14;
        L.drawText(x, y, "モード:" + (mode == "space" ? "空間" : "立ち絵"), dim, 255, true); y += 28;

        for (var i = 0; i < tachies.count; i++) {
            var t = tachies[i];
            var on = isSelected(i);
            // 見出し(選択キャラは緑丸+明色、非選択は暗色)
            L.fillRect(0, y - 4, INSP_W, 30, on ? 0xFF1E2A24 : 0xFF191c24);
            L.font.height = 17;
            L.drawText(x, y, (on ? "● " : "○ ") + slotName(i),
                       on ? sel : off, 255, true);
            y += 34;
            L.font.height = 14;
            var kv = [
                ["表情", (t.emotion  == "" ? "neutral" : t.emotion)],
                ["動作", (t.motionId == "" ? "-" : t.motionId)],
                ["目線", (t.lookAtCamera ? "ON" : "off")],
                ["瞬き", (t.blinkEnabled ? "ON" : "off")],
                ["idle", (t.idleEnabled ? "ON" : "off")],
                ["構図", t.preset]
            ];
            if (mode == "space")
                kv.add(["位置", "x" + fmt1(t.offX) + " z" + fmt1(t.offZ)]);
            for (var j = 0; j < kv.count; j++) {
                L.drawText(x + 6,  y, kv[j][0], dim,   255, true);
                L.drawText(x + 62, y, kv[j][1], white, 255, true);
                y += 24;
            }
            y += 12;
        }
        L.update();
    }
    // 小数1桁の簡易整形(offX/offZ 表示用)
    function fmt1(v)
    {
        var s = (v < 0) ? "-" : "+";
        var a = (v < 0) ? -v : v;
        var w = (int)a;
        var f = (int)((a - w) * 10 + 0.5);
        if (f >= 10) { w += 1; f -= 10; }
        return s + w + "." + f;
    }

    // 下: ログ/情報コンソール(1280x360)。左=情報/操作ヒント、右=操作ログ。
    function drawLog(fps)
    {
        if (logLayer === void) return;
        var L = logLayer;
        L.fillRect(0, 0, LOG_W, LOG_H, 0xFF12141B);
        L.fillRect(0, 0, LOG_W, 2, 0x40FFFFFF);    // 上境界
        try { L.font.face = "ＭＳ ゴシック"; } catch (e) { }
        // ★drawText の色は 24bit(0xRRGGBB)。32bit(0xFFRRGGBB)を渡すと暗く化ける。
        var white = 0xF4F6FA, dim = 0xC2CCDA, key = 0x9AD8FF;
        // 左: タイトル + 状態 + キーヒント
        var x = 24, y = 18;
        L.font.height = 22;
        L.drawText(x, y, "krkr_threepp ADV サンプル", key, 255, true); y += 36;
        L.font.height = 16;
        L.drawText(x, y, "対象:" + (target==0?"左":(target==1?"右":"両方"))
                       + "   FPS:" + (int)fps, dim, 255, true); y += 32;
        L.font.height = 14;
        var hints = [ "Tab: ブラウザ編集UIを開く",
                      "矢印: カメラ旋回   Z/X: ズーム   R: 正面",
                      "編集はブラウザUI(Tab か -webui で開く)から" ];
        for (var i = 0; i < hints.count; i++) { L.drawText(x, y, hints[i], dim, 255, true); y += 24; }
        // 右: 操作ログ(最新が下、収まる分だけ)
        var lx = 560, ly = 18, llh = 22;
        L.fillRect(lx - 24, 14, 2, LOG_H - 28, 0x30FFFFFF);   // 区切り線
        L.font.height = 18;
        L.drawText(lx, ly, "─ 操作ログ ─", key, 255, true); ly += 30;
        L.font.height = 15;
        var maxLines = (int)((LOG_H - ly - 12) / llh);
        var start = logLines.count - maxLines; if (start < 0) start = 0;
        for (var i = start; i < logLines.count; i++) { L.drawText(lx, ly, logLines[i], dim, 255, true); ly += llh; }
        L.update();
    }
    function logLine(s)
    {
        if (logLines === void) logLines = [];
        logLines.add(s);
        while (logLines.count > 18) logLines.erase(0);
    }

    function finalize()
    {
        if (timer !== void) timer.enabled = false;
        for (var i = 0; i < tachies.count; i++) invalidate tachies[i];
        invalidate renderer if renderer !== void;
        invalidate adaptor  if adaptor  !== void;
        super.finalize(...);
    }
}

// 空間モードの描画コールバック(adaptor コンテキストで走るので app を param で受ける)
function spaceRenderCb(w, h, app)
{
    app.renderer.onBeginScene(w, h);
    app.renderer.render(app.spaceScene, app.spaceCamera);
    app.renderer.onEndScene();
}

global.app = new ADVSample();
global.win = app;
app.visible = true;

// ブラウザ編集 UI (webui.tjs) の登録は startup.tjs 側で行う (ビューアモード共通)。
