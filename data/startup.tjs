/**
 * krkrthreepp サンプル起動エントリ
 *
 * 既定で VRM ビューアサンプル (viewer.tjs。ファイルドロップで .vrm/.vrma 表示) を
 * 起動する。テクスチャ付き回転キューブの最小デモは -cube で起動 (cube.tjs)。
 *
 * 起動 (このフォルダ data を krkrz64 に渡す。UTF-8 なので -readencoding 必須):
 *   krkrz64.exe <この data の絶対パス> -readencoding=UTF-8 [オプション]
 *
 *   (無指定)  … VRM ビューア (viewer.tjs)。ウィンドウへ .vrm/.vrma をドロップして表示
 *   -cube     … 回転キューブ最小デモ (cube.tjs)。-shot=out / -lit は従来どおり
 *
 * ※ 3D 表示は WINVER ビルド (x64-windows-win) 推奨。SDL/GL ビルドは画面デバイスと
 *   GLCompositor が GL コンテキストを取り合い黒画面になる (core doc/GLCompositor.md)。
 *   ファイルドロップ (Window.onFileDrop) も現状 WINVER のみ対応。
 */

// --- プラグイン ------------------------------------------------------------
// krkrthreepp.dll: 開発ビルド (build 配下) → exe 隣 (plugin64) の順に探してリンク
var THREEPP_DLL_CANDIDATES = [
    "../build/x64-windows/Release/krkrthreepp.dll",
    "../build/x86-windows/Release/krkrthreepp.dll",
    "krkrthreepp.dll"
];
var threeppLinked = false;
for (var i = 0; i < THREEPP_DLL_CANDIDATES.count; i++) {
    try { Plugins.link(THREEPP_DLL_CANDIDATES[i]); threeppLinked = true;
          Debug.message("krkrthreepp linked: " + THREEPP_DLL_CANDIDATES[i]); break; } catch (e) {}
}
if (!threeppLinked) throw new Exception("krkrthreepp.dll をリンクできません");

// GL コンテキスト提供元を作る (サンプル共通ヘルパ)。
//   新エンジン: 本体内蔵の GLCompositor (ホストの OGL コンテキストに直載り。
//     EGL/ANGLE 不要 = 旧 GLESAdaptor の EGL 経路クラッシュを回避)。
//   旧エンジン: krkrgles.dll の GLESAdaptor へフォールバック。
// どちらも setScreenSize / makeCurrent / capture(layer,cb,param,color) /
// unpremultiply (MSAA premultiplied 縁の白フリンジ対策) が同一 API。
function makeGLAdaptor(win, sw, sh)
{
    var a;
    if (typeof global.GLCompositor != "undefined") {
        a = new global.GLCompositor(win);
    } else {
        if (typeof global.GLESAdaptor == "undefined") Plugins.link("krkrgles.dll");
        a = new global.GLESAdaptor(win);
    }
    a.unpremultiply = true;
    a.setScreenSize(sw, sh);
    return a;
}

// --- 起動分岐 --------------------------------------------------------------
if (System.getArgument("-cube") !== void) {
    Scripts.execStorage("cube.tjs");     // 回転キューブ最小デモ
} else {
    Scripts.execStorage("viewer.tjs");   // VRM ビューア (ファイルドロップ対応)
}
