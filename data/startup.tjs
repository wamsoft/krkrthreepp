/**
 * krkr_threepp / VRM ビューア 動作確認用サンプル
 *
 * 使い方:
 *   1. プロジェクトルートに krkrZ.exe (x86) と ANGLE の libEGL.dll / libGLESv2.dll を置く
 *   2. krkrgles.dll (../../gles) と krkr_threepp.dll (../build) を x86 でビルドしておく
 *   3. このフォルダ (data) をプロジェクトにして krkrZ.exe -readencoding=UTF-8 で起動する
 *      (このスクリプトは UTF-8 なので -readencoding の指定が必要)
 *
 *   起動オプション:
 *     -shot=out  … 60 フレーム進めた結果を PNG 保存して終了する (自動確認用)
 *                  吉里吉里は値から拡張子を落とすので拡張子は付けない
 *     -vrm=名前  … data/<名前>.vrm を読む (既定: model)
 *     -vrma=名前 … data/<名前>.vrma を読んで再生する (既定: anim。none で無効)
 *
 * 操作:
 *   ← / →      … カメラを左右に回す (VRM0.x は正面が逆なので反対側から見る)
 *   ↑ / ↓      … カメラを上下に回す
 *   Z / X      … ズームイン / ズームアウト
 *   Space      … アニメーションを頭から再生し直す
 *   E          … 表情(expression)を順番に切り替える
 *   Enter      … 現在の画面を shot.png へ保存
 */

// --- プラグイン ------------------------------------------------------------
// OpenGL ES コンテキストの提供元 (旧 gles.dll)
Plugins.link("krkrgles.dll");
Plugins.link("../build/x64-windows/Release/krkr_threepp.dll");

var SCREEN_W = 800;
var SCREEN_H = 800;

class VRMViewer extends Window
{
    var adaptor;    // GLESAdaptor (OpenGL ES コンテキスト提供元)
    var renderer;   // Threepp.GLRenderer
    var scene;      // Threepp.Scene
    var camera;     // Threepp.PerspectiveCamera
    var vrm;        // Threepp.VRM
    var anim;       // Threepp.VRMAnimation (無いこともある)
    var animDur;    // アニメの長さ(秒)

    var back;       // 背景レイヤ
    var dest;       // 3D 描画結果を受けるレイヤ
    var timer;
    var lastTick;
    var animTime  = 0.0;
    var frameCount = 0;
    var shotName;

    // カメラ軌道パラメータ (ターゲットを中心に回る)
    var camYaw   = 0.0;      // 0 = +Z 側から見る (VRM1.0 の正面)
    var camPitch = 0.0;
    var camDist  = 2.4;
    var targetY  = 0.9;      // 見る高さ (おおよそ胸〜顔)

    // 表情切り替え用
    var exprNames = ["happy", "angry", "sad", "relaxed", "surprised",
                     "aa", "ih", "ou", "ee", "oh", "blink"];
    var exprIndex = -1;

    function VRMViewer()
    {
        super.Window();
        caption = "krkr_threepp VRM viewer";
        setInnerSize(SCREEN_W, SCREEN_H);

        // 背景 (位置が分かるようにグラデーション + 床線)
        back = new Layer(this, null);
        back.setImageSize(SCREEN_W, SCREEN_H);
        back.setSize(SCREEN_W, SCREEN_H);
        back.setPos(0, 0);
        drawBackground(back);
        back.visible = true;
        add(back);

        // 3D 描画結果を受けるレイヤ。
        // krkrgles の読み戻しはα値を保持しないため加算合成で重ねる。
        dest = new Layer(this, back);
        dest.setImageSize(SCREEN_W, SCREEN_H);
        dest.setSize(SCREEN_W, SCREEN_H);
        dest.setPos(0, 0);
        dest.type = ltAlpha;   // 3D結果(α込み)を背景へ通常アルファ合成
        dest.visible = true;
        add(dest);

        // --- GLES コンテキストの用意 ---------------------------------
        adaptor = new GLESAdaptor(this);
        adaptor.setScreenSize(SCREEN_W, SCREEN_H);
        adaptor.makeCurrent();

        // --- threepp の初期化 ----------------------------------------
        // 生成時のコンテキストがそのまま使われるので makeCurrent 後に生成する
        renderer = new Threepp.GLRenderer(adaptor, SCREEN_W, SCREEN_H);
        renderer.setClearColor(0x000000, 0.0);
        Debug.message("GLRenderer constructed OK");

        // -noloop: 描画ループ(capture)を一切開始しない。GLRenderer 構築だけで
        // crash するか(=initGlad/構築時 GL 呼び出しが原因か)を切り分ける。
        if (System.getArgument("-noloop") !== void) {
            Debug.message("noloop mode: renderer built, no capture loop");
            return;
        }

        scene  = new Threepp.Scene();
        camera = new Threepp.PerspectiveCamera(35, SCREEN_W / SCREEN_H, 0.1, 100);

        // ライト (three-vrm の標準的な構成に近い)
        var dir = new Threepp.DirectionalLight(0xffffff, 1.4);
        dir.setPosition(1, 1, 1);
        scene.add(dir);
        var amb = new Threepp.AmbientLight(0xffffff, 0.6);
        scene.add(amb);

        // --- VRM 読み込み --------------------------------------------
        // -novrm: VRM を読まず空シーンだけ描く (GLES/glad 結線の切り分け用)
        if (System.getArgument("-novrm") !== void) {
            Debug.message("novrm mode: render empty scene only");
            updateCamera();
            lastTick = System.getTickCount();
            shotName = System.getArgument("-shot");
            if (shotName !== void) shotName += ".png";
            timer = new Timer(this, "onFrame");
            timer.interval = 16;
            timer.enabled = true;
            add(timer);
            return;
        }

        var vrmName = System.getArgument("-vrm");
        if (vrmName === void) vrmName = "model";
        // 吉里吉里のストレージ(アーカイブ/暗号化対応)から読む。プラグイン側で
        // TVPCreateStream で開き、バイト列を threepp のメモリロードへ渡す。
        // getPlacedPath で確実に解決してからストレージ名を渡す。
        var vrmStorage = Storages.getPlacedPath(vrmName + ".vrm");
        // 注: TJS では `new X().method()` の連鎖で例外になることがあるため
        // ローダは一旦変数に受けてから load を呼ぶ。
        var vrmLoader = new Threepp.VRMLoader();
        vrm = vrmLoader.loadStorage(vrmStorage);
        if (vrm === void) {
            Debug.message("VRM load failed: " + vrmStorage);
            System.exit(1);
        }
        if (System.getArgument("-noadd") === void) scene.add(vrm.getScene());
        if (System.getArgument("-nometa") === void)
            Debug.message("VRM: name=" + vrm.getMetaName()
                          + " bones=" + vrm.getBoneCount()
                          + " expressions=" + vrm.getExpressionCount());

        // --- VRMA (アニメーション) -----------------------------------
        var vrmaName = System.getArgument("-vrma");
        if (vrmaName === void) vrmaName = "anim";
        if (vrmaName != "none") {
            var vaLoader = new Threepp.VRMAnimationLoader();
            anim = vaLoader.loadStorage(Storages.getPlacedPath(vrmaName + ".vrma"));
            if (anim !== void) {
                animDur = anim.getDuration();
                Debug.message("VRMA loaded: " + vrmaName + ".vrma  duration="
                              + animDur + "s  tracks=" + anim.getBoneTrackCount());
            } else {
                Debug.message("VRMA load failed (skip): " + vrmaName + ".vrma");
            }
        }

        updateCamera();

        lastTick = System.getTickCount();
        shotName = System.getArgument("-shot");
        if (shotName !== void) shotName += ".png";

        if (System.getArgument("-noframe") !== void) {
            Debug.message("noframe: VRM loaded, render loop skipped");
            return;
        }
        timer = new Timer(this, "onFrame");
        timer.interval = 16;
        timer.enabled = true;
        add(timer);
    }

    // 吉里吉里のストレージ名 → threepp が open できる OS ファイルパスへ解決
    function localPath(name)
    {
        return Storages.getLocalName(Storages.getPlacedPath(name));
    }

    // 縦グラデ背景 + 中心の縦線
    function drawBackground(layer)
    {
        for (var y = 0; y < SCREEN_H; y++) {
            var t = y / SCREEN_H;
            var r = (int)(0x20 + 0x30 * t);
            var g = (int)(0x28 + 0x38 * t);
            var b = (int)(0x38 + 0x48 * t);
            layer.fillRect(0, y, SCREEN_W, 1, 0xFF000000 + (r << 16) + (g << 8) + b);
        }
        layer.fillRect(SCREEN_W / 2, 0, 1, SCREEN_H, 0x30FFFFFF);
    }

    // 軌道パラメータからカメラ位置を更新する
    function updateCamera()
    {
        var cy = Math.cos(camPitch);
        var px = camDist * Math.sin(camYaw) * cy;
        var py = targetY + camDist * Math.sin(camPitch);
        var pz = camDist * Math.cos(camYaw) * cy;
        camera.setPosition(px, py, pz);
        camera.lookAt(0, targetY, 0);
    }

    function onFrame()
    {
        var now  = System.getTickCount();
        var tick = now - lastTick;
        lastTick = now;
        if (tick > 100) tick = 100;   // 停止していた場合に飛びすぎないように

        // --- 更新 ----------------------------------------------------
        if (anim !== void && animDur > 0) {
            animTime += tick / 1000.0;
            if (animTime > animDur) animTime -= animDur;
            vrm.applyAnimation(anim, animTime);
        }
        if (vrm !== void && System.getArgument("-noupdate") === void) vrm.update(tick / 1000.0);   // rig/表情/視線/揺れを反映(dt秒)

        // --- 描画 ----------------------------------------------------
        // capture のコールバックは GLESAdaptor のコンテキストで実行されるため、
        // このクラスのメンバは見えない。必要なものは param 経由で渡す。
        adaptor.capture(dest, onRender, this, 0x00000000);
        dest.update();

        frameCount++;

        // -shot=xxx 指定時: 60 フレーム進めた絵を保存して終了する
        if (shotName !== void && frameCount >= 60) {
            timer.enabled = false;
            saveShot(shotName);
            System.exit(0);
        }
    }

    function onRender(w, h, self)
    {
        // -norender: GL 呼び出しを一切せず、GLRenderer 構築のみで crash するか切り分ける
        if (System.getArgument("-norender") !== void) return;
        self.renderer.onBeginScene(w, h);
        self.renderer.render(self.scene, self.camera);
        self.renderer.onEndScene();
    }

    function saveShot(name)
    {
        // 背景と合成した見た目で保存する
        var shot = new Layer(this, back);
        shot.visible = false;
        shot.setImageSize(SCREEN_W, SCREEN_H);
        shot.setSize(SCREEN_W, SCREEN_H);
        shot.copyRect(0, 0, back, 0, 0, SCREEN_W, SCREEN_H);
        shot.operateRect(0, 0, dest, 0, 0, SCREEN_W, SCREEN_H, omAdditive);
        shot.saveLayerImage(name, "png24");
        invalidate shot;
        Debug.message("saved: " + name);
    }

    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_LEFT:   camYaw   -= 0.15; updateCamera(); break;
        case VK_RIGHT:  camYaw   += 0.15; updateCamera(); break;
        case VK_UP:     camPitch += 0.10; if (camPitch >  1.4) camPitch =  1.4; updateCamera(); break;
        case VK_DOWN:   camPitch -= 0.10; if (camPitch < -1.4) camPitch = -1.4; updateCamera(); break;
        case VK_Z:      camDist  /= 1.1;  if (camDist  <  0.4) camDist  =  0.4; updateCamera(); break;
        case VK_X:      camDist  *= 1.1;  if (camDist  > 20.0) camDist  = 20.0; updateCamera(); break;
        case VK_SPACE:  animTime  = 0.0; break;
        case VK_E:      cycleExpression(); break;
        case VK_RETURN: saveShot("shot.png"); break;
        default:
            super.onKeyDown(key, shift);
            return;
        }
    }

    // 表情を順に当てる (前の表情は 0 に戻す)
    function cycleExpression()
    {
        if (exprIndex >= 0)
            vrm.setExpression(exprNames[exprIndex], 0.0);
        exprIndex++;
        if (exprIndex >= exprNames.count) exprIndex = 0;
        vrm.setExpression(exprNames[exprIndex], 1.0);
        Debug.message("expression: " + exprNames[exprIndex]);
    }

    function finalize()
    {
        if (timer !== void) timer.enabled = false;
        // 破棄順序: threepp オブジェクト → adaptor
        invalidate anim     if anim     !== void;
        invalidate vrm      if vrm      !== void;
        invalidate renderer if renderer !== void;
        invalidate adaptor  if adaptor  !== void;
        super.finalize(...);
    }
}

var win = new VRMViewer();
win.visible = true;
