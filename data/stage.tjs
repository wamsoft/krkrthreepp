/**
 * stage.tjs — 舞台メタ定義 (キャラ / モーション)
 *
 * advsample.tjs が execStorage して global.stageDef を読む。JSON プラグインに
 * 依存しない TJS 辞書。将来の複数キャラ定義・宣言的 ADV 連携もこの器を拡張する。
 *
 * characters: 左右に並べるキャラ (今は2体固定)。
 *   id/name/vrm(ファイル名)/frontZ(+1=VRM1.0 正面 / -1=VRM0.x)
 * motions: 配置した VRMA。パネルから再生する。
 *   id/name/file(vrmaファイル名)/loop(1=ループ / 0=一度再生して保持=ポーズ)
 */
global.stageDef = %[
    "characters" => [
        %[ "id" => "left",  "name" => "モデル",   "vrm" => "model",                "frontZ" => 1 ],
        %[ "id" => "right", "name" => "アバター", "vrm" => "AvatarSample_A_VRM1_0", "frontZ" => 1 ]
    ],
    // 合成表情: 複数の VRM 表情を weight つきで束ね、1つの名前で一括指定する。
    // set は [表情名, weight, 表情名, weight, …] のフラット配列。
    "expressions" => [
        %[ "id" => "grin",      "name" => "にっこり",   "set" => [ "happy", 1.0, "relaxed", 0.5 ] ],
        %[ "id" => "opensmile", "name" => "笑顔(口開)", "set" => [ "happy", 0.7, "aa", 0.6 ] ],
        %[ "id" => "shock",     "name" => "絶句",       "set" => [ "surprised", 0.8, "oh", 0.5 ] ]
    ],

    // loop=1 はループ再生、loop=0 は一度再生して最終ポーズを保持(=ポーズ付け)。
    // ※ VRMA によっては hips 回転等を含み崩れるものがある(素材依存)。動作確認済みのみ登録。
    "motions" => [
        %[ "id" => "idle",   "name" => "待機",   "file" => "anim.vrma",       "loop" => 1 ],
        %[ "id" => "behind", "name" => "後ろ手", "file" => "pose_behind.vrma", "loop" => 0 ],
        %[ "id" => "left",   "name" => "左向き", "file" => "pose_left.vrma",   "loop" => 0 ],
        // ポーズ列モーション: 素立ち↔採取ポーズ("cap") を繋いでループ。
        // 事前にパネル「ポーズ:採取」で cap を採っておく(未採取なら素立ちのまま)。
        %[ "id" => "seqdemo", "name" => "ポーズ列", "type" => "poseseq", "loop" => 1,
           "keys" => [ %[ "pose"=>"rest", "in"=>0.4, "hold"=>0.4 ],
                       %[ "pose"=>"cap",  "in"=>0.5, "hold"=>0.7 ] ] ]
    ],

    // 名前付きシーン(宣言的に各キャラの表情/モーション/視線を一括指定)。
    // chars のキーは characters の id。各値: expr(表情名/"neutral") / motion(モーションid/"none") /
    // gaze("camera"=カメラ目線ON / "off")。省略した項目は変更しない。
    "scenes" => [
        %[ "id" => "reset", "name" => "標準",
           "chars" => %[ "left"  => %[ "expr"=>"neutral", "motion"=>"none", "gaze"=>"off" ],
                         "right" => %[ "expr"=>"neutral", "motion"=>"none", "gaze"=>"off" ] ] ],
        %[ "id" => "talk", "name" => "会話",
           "chars" => %[ "left"  => %[ "expr"=>"happy",   "motion"=>"idle", "gaze"=>"camera" ],
                         "right" => %[ "expr"=>"relaxed", "motion"=>"left" ] ] ],
        %[ "id" => "surprise", "name" => "驚き",
           "chars" => %[ "left"  => %[ "expr"=>"surprised", "motion"=>"behind" ],
                         "right" => %[ "expr"=>"surprised", "motion"=>"none" ] ] ]
    ]
];
