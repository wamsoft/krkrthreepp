		 */
		function Reflector(geometry);
		
		property type;  // 型名（読み取り専用）
	}

	// ============================================================
	// Curve クラス
	// ============================================================

	/**
	 * 2D直線カーブ
	 * @description 2点間の直線を表現するカーブです。
	 */
	class LineCurve {
		/**
		 * コンストラクタ
		 * @param v1 始点 (Vector2 または [x, y])
		 * @param v2 終点 (Vector2 または [x, y])
		 */
		function LineCurve(v1, v2);
		
		property v1;  // 始点（読み取り専用）
		property v2;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
		function getPointAt(u);    // 等間隔パラメータ u の点を取得
		function getTangent(t);    // 接線ベクトルを取得
	}

	/**
	 * 3D直線カーブ
	 * @description 3D空間での2点間の直線を表現するカーブです。
	 */
	class LineCurve3 {
		/**
		 * コンストラクタ
		 * @param v1 始点 (Vector3 または [x, y, z])
		 * @param v2 終点 (Vector3 または [x, y, z])
		 */
		function LineCurve3(v1, v2);
		
		property v1;  // 始点（読み取り専用）
		property v2;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
		function getPointAt(u);    // 等間隔パラメータ u の点を取得
		function getTangent(t);    // 接線ベクトルを取得
	}

	/**
	 * 2D二次ベジェカーブ
	 * @description 制御点1つを持つ二次ベジェ曲線です。
	 */
	class QuadraticBezierCurve {
		/**
		 * コンストラクタ
		 * @param v0 始点
		 * @param v1 制御点
		 * @param v2 終点
		 */
		function QuadraticBezierCurve(v0, v1, v2);
		
		property v0;  // 始点（読み取り専用）
		property v1;  // 制御点（読み取り専用）
		property v2;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 3D二次ベジェカーブ
	 * @description 3D空間での二次ベジェ曲線です。
	 */
	class QuadraticBezierCurve3 {
		/**
		 * コンストラクタ
		 * @param v0 始点
		 * @param v1 制御点
		 * @param v2 終点
		 */
		function QuadraticBezierCurve3(v0, v1, v2);
		
		property v0;  // 始点（読み取り専用）
		property v1;  // 制御点（読み取り専用）
		property v2;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 2D三次ベジェカーブ
	 * @description 制御点2つを持つ三次ベジェ曲線です。
	 */
	class CubicBezierCurve {
		/**
		 * コンストラクタ
		 * @param v0 始点
		 * @param v1 制御点1
		 * @param v2 制御点2
		 * @param v3 終点
		 */
		function CubicBezierCurve(v0, v1, v2, v3);
		
		property v0;  // 始点（読み取り専用）
		property v1;  // 制御点1（読み取り専用）
		property v2;  // 制御点2（読み取り専用）
		property v3;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 3D三次ベジェカーブ
	 * @description 3D空間での三次ベジェ曲線です。
	 */
	class CubicBezierCurve3 {
		/**
		 * コンストラクタ
		 * @param v0 始点
		 * @param v1 制御点1
		 * @param v2 制御点2
		 * @param v3 終点
		 */
		function CubicBezierCurve3(v0, v1, v2, v3);
		
		property v0;  // 始点（読み取り専用）
		property v1;  // 制御点1（読み取り専用）
		property v2;  // 制御点2（読み取り専用）
		property v3;  // 終点（読み取り専用）
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 2Dスプラインカーブ
	 * @description 複数の点を通過するスムーズな曲線です。
	 */
	class SplineCurve {
		/**
		 * コンストラクタ
		 * @param points 点の配列 (Vector2の配列または [x,y] の配列)
		 */
		function SplineCurve(points);
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 楕円カーブ
	 * @description 楕円または円弧を表現するカーブです。
	 */
	class EllipseCurve {
		/**
		 * コンストラクタ
		 * @param aX 中心X座標
		 * @param aY 中心Y座標
		 * @param xRadius X方向の半径
		 * @param yRadius Y方向の半径
		 * @param aStartAngle 開始角度 (ラジアン)
		 * @param aEndAngle 終了角度 (ラジアン)
		 * @param aClockwise 時計回りかどうか
		 * @param aRotation 楕円の回転角度 (ラジアン)
		 */
		function EllipseCurve(aX=0, aY=0, xRadius=1, yRadius=1, aStartAngle=0, aEndAngle=Math.PI*2, aClockwise=false, aRotation=0);
		
		property aX;          // 中心X座標
		property aY;          // 中心Y座標
		property xRadius;     // X方向の半径
		property yRadius;     // Y方向の半径
		property aStartAngle; // 開始角度
		property aEndAngle;   // 終了角度
		property aClockwise;  // 時計回りフラグ
		property aRotation;   // 回転角度
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * CatmullRom スプライン曲線
	 * @description 制御点を通過する滑らかな曲線を生成します。
	 */
	class CatmullRomCurve3 {
		/**
		 * コンストラクタ
		 * @param points 制御点の配列 (Vector3の配列または [x,y,z] の配列)
		 * @param closed 閉曲線かどうか
		 * @param curveType 曲線タイプ (centripetal, chordal, catmullrom)
		 * @param tension テンション値 (catmullrom タイプ用)
		 */
		function CatmullRomCurve3(points, closed=false, curveType=0, tension=0.5);
		
		property closed;   // 閉曲線フラグ
		property tension;  // テンション
		
		function getLength();      // 曲線の長さを取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
	}

	/**
	 * 2Dパス
	 * @description 複数のカーブを組み合わせた2Dパスを作成します。
	 *              Canvas API と同様のメソッドで描画できます。
	 */
	class Path {
		/**
		 * コンストラクタ
		 * @param points 初期点の配列（省略可）
		 */
		function Path(points);
		
		property autoClose;     // パスを自動的に閉じるか
		property currentPoint;  // 現在のペン位置（読み取り専用）
		
		function getLength();      // パスの全長を取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
		function getPointAt(u);    // 等間隔パラメータ u の点を取得
		
		function moveTo(x, y);     // ペンを移動
		function lineTo(x, y);     // 直線を描画
		function quadraticCurveTo(cpX, cpY, x, y);  // 二次ベジェ曲線を描画
		function bezierCurveTo(cp1x, cp1y, cp2x, cp2y, x, y);  // 三次ベジェ曲線を描画
		function arc(x, y, radius, startAngle, endAngle, clockwise);  // 相対位置から円弧を描画
		function absarc(x, y, radius, startAngle, endAngle, clockwise);  // 絶対位置で円弧を描画
		function absellipse(x, y, xRadius, yRadius, startAngle, endAngle, clockwise, rotation);  // 楕円を描画
		function splineThru(points);  // 点の配列を通過するスプライン
		function closePath();      // パスを閉じる
	}

	/**
	 * Shape（穴付き2D形状）
	 * Pathを継承し、穴を追加できる2D形状クラス
	 * ExtrudeGeometryやShapeGeometryで使用
	 */
	class Shape {
		/**
		 * コンストラクタ
		 * @param points 初期点の配列（省略可）
		 */
		function Shape(points);
		
		property autoClose;     // パスを自動的に閉じるか
		property currentPoint;  // 現在のペン位置（読み取り専用）
		
		function getLength();      // パスの全長を取得
		function getPoint(t);      // パラメータ t (0-1) の点を取得
		function getPointAt(u);    // 等間隔パラメータ u の点を取得
		
		// Pathと同じ描画メソッド
		function moveTo(x, y);     // ペンを移動
		function lineTo(x, y);     // 直線を描画
		function quadraticCurveTo(cpX, cpY, x, y);  // 二次ベジェ曲線を描画
		function bezierCurveTo(cp1x, cp1y, cp2x, cp2y, x, y);  // 三次ベジェ曲線を描画
		function arc(x, y, radius, startAngle, endAngle, clockwise);  // 相対位置から円弧を描画
		function absarc(x, y, radius, startAngle, endAngle, clockwise);  // 絶対位置で円弧を描画
		function absellipse(x, y, xRadius, yRadius, startAngle, endAngle, clockwise, rotation);  // 楕円を描画
		function splineThru(points);  // 点の配列を通過するスプライン
		function closePath();      // パスを閉じる
		
		// 穴の管理
		function addHole(hole);    // 穴を追加（Pathオブジェクト）
		function getHole(index);   // 穴を取得
		function getHoleCount();   // 穴の数を取得
		function uuid();           // 形状のUUIDを取得
	}

	/**
	 * ShapeGeometry（2D形状ジオメトリ）
	 * Shapeから平面的なジオメトリを生成
	 */
	class ShapeGeometry {
		/**
		 * コンストラクタ
		 * @param shape Shapeオブジェクトまたは配列
		 * @param curveSegments カーブの分割数（デフォルト: 12）
		 */
		function ShapeGeometry(shape, curveSegments);
	}

	/**
	 * ExtrudeGeometry（押し出しジオメトリ）
	 * Shapeを押し出して3Dジオメトリを生成
	 */
	class ExtrudeGeometry {
		/**
		 * コンストラクタ
		 * @param shape Shapeオブジェクトまたは配列
		 * @param options 押し出しオプション（辞書）
		 *   - curveSegments: カーブの分割数
		 *   - steps: 押し出しのステップ数
		 *   - depth: 押し出しの深さ
		 *   - bevelEnabled: ベベルを有効にするか
		 *   - bevelThickness: ベベルの厚さ
		 *   - bevelSize: ベベルのサイズ
		 *   - bevelOffset: ベベルのオフセット
		 *   - bevelSegments: ベベルの分割数
		 */
		function ExtrudeGeometry(shape, options);
	}

	// CurveType 定数
	const CatmullRomCurve3_CurveType_centripetal = 0;
	const CatmullRomCurve3_CurveType_chordal = 1;
	const CatmullRomCurve3_CurveType_catmullrom = 2;
}

/**
 * 使用例
 * 
 * // シーンとカメラの作成
 * var scene = new Threepp.Scene();
 * var camera = new Threepp.PerspectiveCamera(75, 16/9, 0.1, 1000);
 * camera.position.z = 5;
 * 
 * // ジオメトリとマテリアルの作成
 * var geometry = new Threepp.BoxGeometry(1, 1, 1);
 * var material = new Threepp.MeshPhongMaterial();
 * material.color = 0x00ff00;
 * 
 * // メッシュを作成してシーンに追加
 * var mesh = new Threepp.Mesh(geometry, material);
 * scene.add(mesh);
 * 
 * // ライト追加
 * var light = new Threepp.DirectionalLight(0xffffff, 1.0);
 * light.position.set(1, 1, 1);
 * scene.add(light);
 * 
 * // 環境光も追加
 * var ambient = new Threepp.AmbientLight(0x404040);
 * scene.add(ambient);
 * 
 * // レンダラー作成と描画
 * var renderer = new Threepp.GLRenderer(800, 600);
 * renderer.setClearColor(0x000000);
 * renderer.render(scene, camera);
 * 
 * // アニメーション例
 * var clock = new Threepp.Clock();
 * function animate() {
 *     var delta = clock.getDelta();
 *     mesh.rotateY(delta);
 *     renderer.render(scene, camera);
 * }
 * 
 * // ヘルパーの使用例
 * var axes = new Threepp.AxesHelper(5);
 * scene.add(axes);
 * 
 * var grid = new Threepp.GridHelper(10, 10);
 * scene.add(grid);
 * 
 * // テクスチャの読み込み例
 * var loader = new Threepp.TextureLoader();
 * var texture = loader.load("texture.png");
 * 
 * // シェーダーマテリアルの例
 * var shaderMat = new Threepp.ShaderMaterial();
 * shaderMat.vertexShader = "...";
 * shaderMat.fragmentShader = "...";
 * 
 * // LODの使用例
 * var lod = new Threepp.LOD();
 * var highDetail = new Threepp.Mesh(new Threepp.SphereGeometry(1, 64, 64), material);
 * var medDetail = new Threepp.Mesh(new Threepp.SphereGeometry(1, 32, 32), material);
 * var lowDetail = new Threepp.Mesh(new Threepp.SphereGeometry(1, 16, 16), material);
 * lod.addLevel(highDetail, 0);
 * lod.addLevel(medDetail, 50);
 * lod.addLevel(lowDetail, 100);
 * scene.add(lod);
 * 
 * // CatmullRomCurve3 の使用例
 * var points = [
 *     [0, 0, 0],
 *     [1, 1, 0],
 *     [2, 0, 0],
 *     [3, 1, 0]
 * ];
 * var curve = new Threepp.CatmullRomCurve3(points, false);
 * var point = curve.getPoint(0.5);  // 曲線の中間点を取得
 * 
 * // Path の使用例（Canvas API 風の描画）
 * var path = new Threepp.Path();
 * path.moveTo(0, 0);
 * path.lineTo(100, 0);
 * path.quadraticCurveTo(150, 50, 100, 100);
 * path.bezierCurveTo(50, 150, 0, 150, 0, 100);
 * path.closePath();
 * 
 * // 2Dベジェカーブの例
 * var bezier = new Threepp.CubicBezierCurve(
 *     [0, 0],      // 始点
 *     [0.5, 1],    // 制御点1
 *     [1, 1],      // 制御点2
 *     [1, 0]       // 終点
 * );
 * var midPoint = bezier.getPoint(0.5);
 * 
 * // 楕円カーブの例
 * var ellipse = new Threepp.EllipseCurve(
 *     0, 0,        // 中心座標
 *     10, 5,       // X半径, Y半径
 *     0, Math.PI,  // 開始角度, 終了角度（半円）
 *     false,       // 時計回り
 *     0            // 回転
 * );
 * 
 * // LineCurve3 の例（3D直線）
 * var line3d = new Threepp.LineCurve3([0, 0, 0], [10, 10, 10]);
 * var length = line3d.getLength();
 * var tangent = line3d.getTangent(0.5);  // 接線ベクトル
 * 
 * // LatheGeometry の使用例（花瓶のような形状）
 * var lathePoints = [
 *     [0.0, 0.0],
 *     [0.5, 0.0],
 *     [0.5, 0.5],
 *     [0.3, 1.0],
 *     [0.4, 1.5],
