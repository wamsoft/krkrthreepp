	}

	// ============================================================
	// Texture クラス
	// ============================================================

	/**
	 * テクスチャ基底クラス
	 * @description 画像テクスチャを表現します。
	 */
	class Texture {
		/**
		 * コンストラクタ
		 */
		function Texture();
		
		property id;              // ID（読み取り専用）
		property name;            // 名前
		property mapping;         // マッピング種別
		property wrapS;           // S方向のラッピング
		property wrapT;           // T方向のラッピング
		property magFilter;       // 拡大フィルタ
		property minFilter;       // 縮小フィルタ
		property anisotropy;      // 異方性フィルタリング
		property format;          // フォーマット
		property offset;          // オフセット (Vector2、読み取り専用)
		property repeat;          // 繰り返し (Vector2、読み取り専用)
		property center;          // 中心 (Vector2、読み取り専用)
		property rotation;        // 回転
		property matrixAutoUpdate; // 行列の自動更新
		property generateMipmaps; // ミップマップを生成するか
		property premultiplyAlpha; // 事前アルファ乗算
		property unpackAlignment; // アンパックアラインメント
		property encoding;        // エンコーディング
		
		function updateMatrix();  // 行列を更新
		function dispose();       // リソースを解放
		function needsUpdate();   // 更新フラグを立てる
		function version();       // バージョンを取得
	}

	/**
	 * データテクスチャ
	 * @description ピクセルデータから生成するテクスチャです。
	 */
	class DataTexture {
		/**
		 * コンストラクタ
		 * @param channels チャンネル数
		 * @param width 幅
		 * @param height 高さ
		 */
		function DataTexture(channels=4, width=1, height=1);
	}

	/**
	 * テクスチャローダー
	 * @description ファイルからテクスチャを読み込みます。
	 */
	class TextureLoader {
		/**
		 * コンストラクタ
		 * @param useCache キャッシュを使用するか
		 */
		function TextureLoader(useCache=true);
		
		/**
		 * テクスチャを読み込む
		 * @param path ファイルパス
		 * @param flipY Y軸を反転するか
		 * @return Texture
		 */
		function load(path, flipY=true);
		
		/**
		 * キャッシュをクリア
		 */
		function clearCache();
	}

	// ============================================================
	// Helper クラス
	// ============================================================

	/**
	 * 軸ヘルパー
	 * @description X(赤), Y(緑), Z(青)の軸を表示します。
	 */
	class AxesHelper {
		/**
		 * コンストラクタ
		 * @param size 軸の長さ
		 */
		function AxesHelper(size=1);
		
		property type;  // "AxesHelper"（読み取り専用）
	}

	/**
	 * グリッドヘルパー
	 * @description 格子状のグリッドを表示します。
	 */
	class GridHelper {
		/**
		 * コンストラクタ
		 * @param size グリッドのサイズ
		 * @param divisions 分割数
		 * @param color1 主線の色
		 * @param color2 副線の色
		 */
		function GridHelper(size=10, divisions=10, color1=0x444444, color2=0x888888);
		
		property type;  // "GridHelper"（読み取り専用）
	}

	/**
	 * 矢印ヘルパー
	 * @description 方向を示す矢印を表示します。
	 */
	class ArrowHelper {
		/**
		 * コンストラクタ
		 * @param dir 方向ベクトル [x, y, z]
		 * @param origin 原点 [x, y, z]
		 * @param length 長さ
		 * @param color 色 (0xRRGGBB)
		 */
		function ArrowHelper(dir=[0,0,1], origin=[0,0,0], length=1, color=0xffff00);
		
		function setDirection(dir);    // 方向を設定
		function setLength(length, headLength=void, headWidth=void); // 長さを設定
		function setColor(color);      // 色を設定
	}

	/**
	 * ボックスヘルパー
	 * @description オブジェクトの境界ボックスを表示します。
	 */
	class BoxHelper {
		/**
		 * コンストラクタ
		 * @param object 対象のObject3D
		 * @param color 色 (0xRRGGBB)
		 */
		function BoxHelper(object, color=0xffff00);
		
		property type;  // "BoxHelper"（読み取り専用）
		
		function update();  // 更新
	}

	// ============================================================
	// Scene 補助クラス
	// ============================================================

	/**
	 * フォグ（線形）
	 * @description 線形フォグを設定します。
	 */
	class Fog {
		/**
		 * コンストラクタ
		 * @param color フォグの色
		 * @param near フォグ開始距離
		 * @param far フォグ終了距離
		 */
		function Fog(color, near=1, far=1000);
		
		property color;     // フォグの色
		property nearPlane; // 開始距離
		property farPlane;  // 終了距離
	}

	/**
	 * フォグ（指数関数）
	 * @description 指数関数フォグを設定します。
	 */
	class FogExp2 {
		/**
		 * コンストラクタ
		 * @param color フォグの色
		 * @param density 密度
		 */
		function FogExp2(color, density=0.00025);
		
		property color;   // フォグの色
		property density; // 密度
	}

	/**
	 * レイキャスター
	 * @description レイを使ってオブジェクトとの交差判定を行います。
	 */
	class Raycaster {
		/**
		 * コンストラクタ
		 * @param origin 原点
		 * @param direction 方向
		 * @param near ニアクリップ
		 * @param far ファークリップ
		 */
		function Raycaster(origin, direction, near=0, far=Infinity);
		
		property nearPlane; // ニアクリップ
		property farPlane;  // ファークリップ
		
		function set(origin, direction); // 原点と方向を設定
	}

	// ============================================================
	// Renderer クラス
	// ============================================================

	/**
	 * OpenGL レンダラー
	 * @description シーンをレンダリングするためのレンダラーです。
	 */
	class GLRenderer {
		/**
		 * コンストラクタ
		 * @param width レンダリング幅
		 * @param height レンダリング高さ
		 */
		function GLRenderer(width=800, height=600);
		
		property autoClear;        // 自動クリアするか
		property autoClearColor;   // カラーバッファを自動クリアするか
		property autoClearDepth;   // 深度バッファを自動クリアするか
		property autoClearStencil; // ステンシルバッファを自動クリアするか
		property sortObjects;      // オブジェクトをソートするか
		property physicallyCorrectLights; // 物理的に正確なライティング
		property toneMappingExposure; // トーンマッピングの露出
		
		/**
		 * シーンをレンダリング
		 * @param scene シーン
		 * @param camera カメラ
		 */
		function render(scene, camera);
		
		/**
		 * クリアカラーを設定
		 * @param color 色 (0xRRGGBB)
		 * @param alpha アルファ値
		 */
		function setClearColor(color, alpha=1);
		
		function setPixelRatio(ratio); // ピクセル比を設定
		function setSize(width, height); // サイズを設定
		function setScissorTest(enabled); // シザーテストの有効/無効
		function clear(color=true, depth=true, stencil=true); // バッファをクリア
		function clearColor();     // カラーバッファをクリア
		function clearDepth();     // 深度バッファをクリア
		function clearStencil();   // ステンシルバッファをクリア
		function dispose();        // リソースを解放
		function resetState();     // 状態をリセット
	}

	// ============================================================
	// 追加 Math クラス
	// ============================================================

	/**
	 * 2D 軸平行境界ボックスクラス
	 */
	class Box2 {
		/**
		 * コンストラクタ
		 * @param min 最小座標 (Vector2)
		 * @param max 最大座標 (Vector2)
		 */
		function Box2(min, max);
		
		property min;  // 最小座標（読み取り専用）
		property max;  // 最大座標（読み取り専用）
		
		function set(min, max);       // 値を設定
		function clone();             // クローン
		function copy(box);           // コピー
		function makeEmpty();         // 空にする
		function isEmpty();           // 空かどうか
		function expandByPoint(point); // 点で拡張
		function expandByVector(v);   // ベクトルで拡張
		function expandByScalar(s);   // スカラーで拡張
		function containsPoint(point); // 点を含むか
		function containsBox(box);    // ボックスを含むか
		function intersectsBox(box);  // ボックスと交差するか
		function distanceToPoint(point); // 点との距離
		function intersect(box);      // 交差部分を取得
		function union_(box);         // 和集合
		function translate(offset);   // 平行移動
		function equals(box);         // 等価判定
	}

	/**
	 * 3D 線分クラス
	 */
	class Line3 {
		/**
		 * コンストラクタ
		 * @param start 始点 (Vector3)
		 * @param end 終点 (Vector3)
		 */
		function Line3(start, end);
		
		property start;  // 始点（読み取り専用）
		property end;    // 終点（読み取り専用）
		
		function set(start, end);     // 値を設定
		function clone();             // クローン
		function copy(line);          // コピー
		function getCenter();         // 中心を取得
		function delta();             // 方向ベクトルを取得
		function distanceSq();        // 長さの二乗
		function distance();          // 長さ
		function at(t);               // パラメータ位置の点を取得
		function closestPointToPoint(point, clamp); // 最近点を取得
		function closestPointToPointParameter(point, clamp); // 最近点のパラメータ
		function applyMatrix4(m);     // 行列を適用
		function equals(line);        // 等価判定
	}

	/**
	 * 三角形クラス
	 */
	class Triangle {
		/**
		 * コンストラクタ
		 * @param a 頂点A (Vector3)
		 * @param b 頂点B (Vector3)
		 * @param c 頂点C (Vector3)
		 */
		function Triangle(a, b, c);
		
		property a;  // 頂点A（読み取り専用）
		property b;  // 頂点B（読み取り専用）
		property c;  // 頂点C（読み取り専用）
		
		function set(a, b, c);        // 値を設定
		function clone();             // クローン
		function copy(triangle);      // コピー
		function getArea();           // 面積
		function getMidpoint();       // 重心
		function getNormal();         // 法線
		function getPlane();          // 三角形を含む平面
		function getBarycoord(point); // 重心座標を取得
		function containsPoint(point); // 点を含むか
		function isFrontFacing(direction); // 前面を向いているか
		function closestPointToPoint(point); // 最近点
		function equals(triangle);    // 等価判定
	}

	/**
	 * 球面座標クラス
	 */
	class Spherical {
		/**
		 * コンストラクタ
		 * @param radius 半径
		 * @param phi 極角 (ラジアン)
		 * @param theta 方位角 (ラジアン)
		 */
		function Spherical(radius=1, phi=0, theta=0);
		
		property radius;  // 半径
		property phi;     // 極角
		property theta;   // 方位角
		
		function set(radius, phi, theta); // 値を設定
		function clone();             // クローン
		function copy(s);             // コピー
		function makeSafe();          // 安全な値に補正
		function setFromVector3(v);   // Vector3から設定
		function setFromCartesianCoords(x, y, z); // 直交座標から設定
	}

	/**
	 * 円柱座標クラス
	 */
	class Cylindrical {
		/**
		 * コンストラクタ
		 * @param radius 半径
		 * @param theta 角度 (ラジアン)
		 * @param y 高さ
		 */
		function Cylindrical(radius=1, theta=0, y=0);
		
		property radius;  // 半径
		property theta;   // 角度
		property y;       // 高さ
		
		function set(radius, theta, y); // 値を設定
		function clone();             // クローン
		function copy(c);             // コピー
		function setFromVector3(v);   // Vector3から設定
		function setFromCartesianCoords(x, y, z); // 直交座標から設定
	}

	// ============================================================
	// 追加 Geometry クラス
	// ============================================================

	/**
	 * カプセルジオメトリ
	 * @description カプセル形状（両端が半球の円柱）を生成します。
	 */
	class CapsuleGeometry {
		/**
		 * コンストラクタ
		 * @param radius 半径
		 * @param length 円柱部分の長さ
		 * @param capSegments キャップのセグメント数
		 * @param radialSegments 周方向のセグメント数
		 */
		function CapsuleGeometry(radius=0.5, length=1, capSegments=8, radialSegments=16);
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * 旋盤ジオメトリ
	 * @description 2D輪郭を回転軸周りに回転させて3D形状を生成します。
	 */
	class LatheGeometry {
		/**
		 * コンストラクタ
		 * @param points 輪郭点の配列 (Vector2の配列または [x,y] の配列)
		 * @param segments セグメント数
		 * @param phiStart 開始角度 (ラジアン)
		 * @param phiLength 回転角度 (ラジアン)
		 */
		function LatheGeometry(points, segments=12, phiStart=0, phiLength=Math.PI*2);
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * エッジジオメトリ
	 * @description 元のジオメトリからエッジ（輪郭線）を抽出します。
	 */
	class EdgesGeometry {
		/**
		 * コンストラクタ
		 * @param geometry 元のジオメトリ
		 * @param thresholdAngle エッジとみなす角度閾値 (度)
		 */
		function EdgesGeometry(geometry, thresholdAngle=1);
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * ワイヤーフレームジオメトリ
	 * @description 元のジオメトリからワイヤーフレームを生成します。
	 */
	class WireframeGeometry {
		/**
		 * コンストラクタ
		 * @param geometry 元のジオメトリ
		 */
		function WireframeGeometry(geometry);
		
		property type;  // 型名（読み取り専用）
	}

	// ============================================================
	// 追加 Helper クラス
	// ============================================================

	/**
	 * カメラヘルパー
	 * @description カメラの視錐台を可視化します。
	 */
	class CameraHelper {
		/**
		 * コンストラクタ
		 * @param camera 可視化するカメラ
		 */
		function CameraHelper(camera);
		
		property type;  // 型名（読み取り専用）
		
		function update();  // ヘルパーを更新
	}

	/**
	 * ディレクショナルライトヘルパー
	 * @description 平行光源の方向を可視化します。
	 */
	class DirectionalLightHelper {
		/**
		 * コンストラクタ
		 * @param light 可視化するライト
		 * @param size ヘルパーのサイズ
		 * @param color ヘルパーの色（省略時はライトの色）
		 */
		function DirectionalLightHelper(light, size=1, color);
		
		property type;  // 型名（読み取り専用）
		
		function update();  // ヘルパーを更新
	}

	/**
	 * ポイントライトヘルパー
	 * @description 点光源を可視化します。
	 */
	class PointLightHelper {
		/**
		 * コンストラクタ
		 * @param light 可視化するライト
		 * @param sphereSize 球のサイズ
		 * @param color ヘルパーの色（省略時はライトの色）
		 */
		function PointLightHelper(light, sphereSize=1, color);
		
		property type;  // 型名（読み取り専用）
		
		function update();  // ヘルパーを更新
	}

	/**
	 * スポットライトヘルパー
	 * @description スポットライトのコーンを可視化します。
	 */
	class SpotLightHelper {
		/**
		 * コンストラクタ
		 * @param light 可視化するライト
		 * @param color ヘルパーの色（省略時はライトの色）
		 */
		function SpotLightHelper(light, color);
		
		property type;  // 型名（読み取り専用）
		
		function update();  // ヘルパーを更新
	}

	/**
	 * 極座標グリッドヘルパー
	 * @description 極座標系のグリッドを表示します。
	 */
	class PolarGridHelper {
		/**
		 * コンストラクタ
		 * @param radius 半径
		 * @param sectors セクター数
		 * @param rings リング数
		 * @param divisions 分割数
		 * @param color1 メインカラー
		 * @param color2 セカンダリカラー
		 */
		function PolarGridHelper(radius=10, sectors=16, rings=8, divisions=64, color1=0x444444, color2=0x888888);
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * 平面ヘルパー
	 * @description 平面を可視化します。
	 */
	class PlaneHelper {
		/**
		 * コンストラクタ
		 * @param plane 可視化する平面
		 * @param size ヘルパーのサイズ
		 * @param color ヘルパーの色
		 */
		function PlaneHelper(plane, size=1, color=0xffff00);
		
		property type;  // 型名（読み取り専用）
		property size;  // サイズ
	}

	// ============================================================
	// 追加 Object クラス
	// ============================================================

	/**
	 * LOD (Level of Detail)
	 * @description 距離に応じて異なる詳細度のオブジェクトを切り替えます。
	 */
	class LOD {
		/**
		 * コンストラクタ
		 */
		function LOD();
		
		property type;       // 型名（読み取り専用）
		property autoUpdate; // 自動更新フラグ
		
		function addLevel(object, distance);  // レベルを追加
		function getCurrentLevel();           // 現在のレベルを取得
		function update(camera);              // カメラに基づいて更新
	}

	/**
	 * ボーン
	 * @description スケルトンアニメーション用のボーンです。
	 */
	class Bone {
		/**
		 * コンストラクタ
		 */
		function Bone();
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * スケルトン
	 * @description ボーンの集合を管理します。
	 */
	class Skeleton {
		/**
		 * コンストラクタ
		 * @param bones ボーンの配列
		 */
		function Skeleton(bones);
		
		property uuid;   // UUID（読み取り専用）
		property frame;  // フレーム
		
		function init();              // 初期化
		function calculateInverses(); // 逆行列を計算
		function pose();              // ポーズを設定
		function update();            // 更新
		function computeBoneTexture(); // ボーンテクスチャを計算
		function dispose();           // リソースを解放
	}

	/**
	 * スキニングメッシュ
	 * @description スケルトンアニメーション対応のメッシュです。
