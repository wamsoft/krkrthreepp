		 */
		function Water(geometry);
		
		property type;  // 型名（読み取り専用）
	}

	/**
	 * 反射面オブジェクト
	 * @description 鏡面反射を持つオブジェクトです。
	 */
	class Reflector {
		/**
		 * コンストラクタ
