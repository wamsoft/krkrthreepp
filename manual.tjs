	class SkinnedMesh {
		/**
		 * コンストラクタ
		 * @param geometry ジオメトリ
		 * @param material マテリアル
		 */
		function SkinnedMesh(geometry, material);
		
		property type;  // 型名（読み取り専用）
		
		function bind(skeleton);       // スケルトンをバインド
		function pose();               // ポーズを設定
		function normalizeSkinWeights(); // スキンウェイトを正規化
	}

	/**
	 * 空オブジェクト
